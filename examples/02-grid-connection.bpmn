        <di:waypoint x="1841.0" y="887.5"/>
        <di:waypoint x="1841.0" y="147.5"/>
        <di:waypoint x="1900.0" y="147.5"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1814.0" y="861.5" width="110" height="22"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
