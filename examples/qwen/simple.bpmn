<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_pool_operator" name="Оператор" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="role_operator" name="Оператор">
        <bpmn:flowNodeRef>start_event_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_completeness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_event_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_event_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event_1" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_register" name="Зарегистрировать заявку">
      <bpmn:documentation>Оператор регистрирует заявку</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_check" name="Проверить комплектность документов">
      <bpmn:documentation>проверяет комплектность документов</bpmn:documentation>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_completeness" name="Комплектность" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_accept" name="Принять заявку">
      <bpmn:documentation>оператор принимает заявку</bpmn:documentation>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_reject" name="Отклонить заявку">
      <bpmn:documentation>оператор отклоняет заявку</bpmn:documentation>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_event_1" name="Конец процесса">
      <bpmn:documentation>завершает процесс</bpmn:documentation>
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_2" name="Конец процесса">
      <bpmn:documentation>завершает процесс</bpmn:documentation>
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_event_1" targetRef="task_register" name=""/>
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_register" targetRef="task_check" name=""/>
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_check" targetRef="gw_completeness" name=""/>
    <bpmn:sequenceFlow id="flow_4" sourceRef="gw_completeness" targetRef="task_accept" name="Комплект полный">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Комплект полный</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_5" sourceRef="gw_completeness" targetRef="task_reject" name="Комплект неполный">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Комплект неполный</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_accept" targetRef="end_event_1" name=""/>
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_reject" targetRef="end_event_2" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="proc_registration" name="Регистрация и проверка заявки">
    <bpmn:documentation>Оператор регистрирует заявку и проверяет комплектность документов. Если комплект полный, оператор принимает заявку и завершает процесс. Если комплект неполный, оператор отклоняет заявку и завершает процесс.</bpmn:documentation>
    <bpmn:participant id="pool_operator" name="Оператор" processRef="Process_pool_operator">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "role_operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "pool_operator"}]}</bpmn:documentation>
    </bpmn:participant>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="proc_registration">
      <bpmndi:BPMNShape id="Shape_pool_operator" bpmnElement="pool_operator" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1280" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_role_operator" bpmnElement="role_operator" isHorizontal="true">
        <dc:Bounds x="90" y="70" width="1250" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_start_event_1" bpmnElement="start_event_1">
        <dc:Bounds x="241.0" y="253.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_register" bpmnElement="task_register">
        <dc:Bounds x="380.0" y="232.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_check" bpmnElement="task_check">
        <dc:Bounds x="570.0" y="232.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gw_completeness" bpmnElement="gw_completeness">
        <dc:Bounds x="804.0" y="246.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_accept" bpmnElement="task_accept">
        <dc:Bounds x="950.0" y="186.66666666666669" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_task_reject" bpmnElement="task_reject">
        <dc:Bounds x="950.0" y="278.33333333333337" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_event_1" bpmnElement="end_event_1">
        <dc:Bounds x="1191.0" y="207.66666666666669" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_event_2" bpmnElement="end_event_2">
        <dc:Bounds x="1191.0" y="299.33333333333337" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_flow_1" bpmnElement="flow_1">
        <di:waypoint x="279.0" y="272.5"/>
        <di:waypoint x="380.0" y="272.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_2" bpmnElement="flow_2">
        <di:waypoint x="520.0" y="272.5"/>
        <di:waypoint x="570.0" y="272.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_3" bpmnElement="flow_3">
        <di:waypoint x="710.0" y="272.5"/>
        <di:waypoint x="804.0" y="272.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_4" bpmnElement="flow_4">
        <di:waypoint x="856.0" y="272.5"/>
        <di:waypoint x="891.0" y="272.5"/>
        <di:waypoint x="891.0" y="226.66666666666669"/>
        <di:waypoint x="950.0" y="226.66666666666669"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1299.0" y="232.5" width="130" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_5" bpmnElement="flow_5">
        <di:waypoint x="856.0" y="272.5"/>
        <di:waypoint x="891.0" y="272.5"/>
        <di:waypoint x="891.0" y="318.33333333333337"/>
        <di:waypoint x="950.0" y="318.33333333333337"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="864.0" y="75" width="130" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_6" bpmnElement="flow_6">
        <di:waypoint x="1090.0" y="226.66666666666669"/>
        <di:waypoint x="1191.0" y="226.66666666666669"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_flow_7" bpmnElement="flow_7">
        <di:waypoint x="1090.0" y="318.33333333333337"/>
        <di:waypoint x="1191.0" y="318.33333333333337"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
