  </bpmn:process>
  <bpmn:collaboration id="process_connection" name="Подключение объекта">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта.
Оператор получает заявку и проверяет документы.
Если документов не хватает или они заполнены неправильно,
оператор возвращает заявку клиенту на доработку.
Клиент исправляет документы и повторно отправляет их оператору.

Если документы корректны,
юридический отдел и служба безопасности одновременно проверяют заявку.
После завершения обеих проверок руководитель принимает решение.

Если заявка отклонена,
оператор отправляет клиенту уведомление об отказе,
после чего процесс завершается.

Если заявка одобрена,
менеджер формирует договор и отправляет его клиенту.

Клиент проверяет договор.
Если клиент не согласен,
он возвращает договор менеджеру на доработку.
Менеджер изменяет договор и повторно отправляет клиенту.

Если клиент согласен,
он подписывает договор и отправляет менеджеру.
Менеджер регистрирует договор,
после чего процесс завершается.</bpmn:documentation>
    <bpmn:documentation>PULSE_ASSUMPTIONS:[{"id": "A1", "text": "После повторной отправки исправленных документов оператор повторно проверяет их.", "source": "user_accepted", "confidence": 0.95}, {"id": "A2", "text": "После повторной отправки изменённого договора клиент повторно проверяет его.", "source": "user_accepted", "confidence": 0.95}]</bpmn:documentation>
    <bpmn:participant id="pool_client" name="Клиент" processRef="Process_pool_client">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "pool_client"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="pool_organization" name="Организация" processRef="Process_pool_organization">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "pool_organization"}, {"id": "legal", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "pool_organization"}, {"id": "security", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "pool_organization"}, {"id": "manager", "name": "Руководитель и менеджер", "type": "role", "kind": "internal", "pool_id": "pool_organization"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf1" sourceRef="c_submit" targetRef="o_start" name="Заявка"/>
    <bpmn:messageFlow id="mf2" sourceRef="o_return_docs" targetRef="c_get_correction" name="Запрос на доработку заявки"/>
    <bpmn:messageFlow id="mf3" sourceRef="c_resend_docs" targetRef="o_get_docs" name="Исправленные документы"/>
    <bpmn:messageFlow id="mf4" sourceRef="o_send_refusal" targetRef="c_get_refusal" name="Уведомление об отказе"/>
    <bpmn:messageFlow id="mf5" sourceRef="o_send_contract" targetRef="c_get_contract" name="Договор"/>
    <bpmn:messageFlow id="mf6" sourceRef="c_return_contract" targetRef="o_get_revision" name="Договор на доработку"/>
    <bpmn:messageFlow id="mf7" sourceRef="o_resend_contract" targetRef="c_get_revision" name="Изменённый договор"/>
    <bpmn:messageFlow id="mf8" sourceRef="c_send_signed" targetRef="o_get_signed" name="Подписанный договор"/>
  </bpmn:collaboration>
