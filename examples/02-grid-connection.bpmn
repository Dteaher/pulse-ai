        <di:waypoint x="1140.0" y="577.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1046.0" y="408.33333333333337"/>
