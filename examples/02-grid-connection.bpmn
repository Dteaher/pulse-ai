        <dc:Bounds x="60" y="70" width="2420" height="1050"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Client" bpmnElement="Client" isHorizontal="true">
        <dc:Bounds x="90" y="70" width="2390" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Operator" bpmnElement="Operator" isHorizontal="true">
