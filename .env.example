# Local demo: no API keys, only the built-in example scenarios.
APP_ENV=development
LLM_PROVIDER=mock
LLM_FALLBACK_ENABLED=false

# Real AI: change LLM_PROVIDER to openai_compatible (or supported provider).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional primary overrides; empty means use LLM_* above.
PRIMARY_LLM_PROVIDER=
PRIMARY_LLM_MODEL=
PRIMARY_LLM_BASE_URL=
PRIMARY_LLM_API_KEY=
# Optional failover, independent credentials. Enable only after configuration.
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
YANDEX_FOLDER_ID=

# Bounded provider calls, JSON/graph repair and request deadline.
LLM_STRUCTURED_OUTPUT=true
LLM_MAX_RETRIES=2
LLM_GRAPH_MAX_RETRIES=1
LLM_TIMEOUT=90
LLM_MAX_TOKENS=8000
LLM_REQUEST_BUDGET=180
LLM_FALLBACK_RESERVE=30
LLM_PERFORMANCE_ENABLED=true
LLM_BUSINESS_COVERAGE_ENABLED=false
LLM_DEBUG_RAW_RESPONSE=false
MAX_CLARIFICATION_ROUNDS=3

# Shared demo access code, NOT an AI provider key. Mandatory in production.
# Use a random value of at least 32 characters; inject via hosting secrets.
PULSE_ACCESS_TOKEN=
# Deployment-wide limits, per backend process. Not a financial billing cap.
API_LIMITS_ENABLED=true
API_MAX_CONCURRENT=2
API_REQUESTS_PER_MINUTE=10
API_REQUESTS_PER_DAY=100
API_MAX_BODY_BYTES=2000000
# Optional Compose domain, e.g. pulse.example.org. Local HTTP: http://localhost
SITE_ADDRESS=localhost
