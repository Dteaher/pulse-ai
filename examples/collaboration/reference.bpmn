<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_ClientPool" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="ClientStart" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Submit" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта</bpmn:documentation>
      <bpmn:incoming>Flow0</bpmn:incoming>
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Wait" name="Ожидать ответ компании">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Reply" name="Какой ответ получен?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
      <bpmn:outgoing>Flow8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="ReceiveReturn" name="Получить запрос на доработку">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Revise" name="Доработать документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow4</bpmn:incoming>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Resubmit" name="Отправить исправленные документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveContract" name="Получить договор">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow7</bpmn:incoming>
      <bpmn:outgoing>Flow9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="ReceiveNotice" name="Получить уведомление об отказе">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow8</bpmn:incoming>
      <bpmn:outgoing>Flow10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="ClientYes" name="Договор получен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ClientNo" name="Отказ получен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow0" sourceRef="ClientStart" targetRef="Submit" name=""/>
    <bpmn:sequenceFlow id="Flow1" sourceRef="Submit" targetRef="Wait" name=""/>
    <bpmn:sequenceFlow id="Flow2" sourceRef="Wait" targetRef="Reply" name=""/>
    <bpmn:sequenceFlow id="Flow3" sourceRef="Reply" targetRef="ReceiveReturn" name="Нужна доработка">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужна доработка</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow4" sourceRef="ReceiveReturn" targetRef="Revise" name=""/>
    <bpmn:sequenceFlow id="Flow5" sourceRef="Revise" targetRef="Resubmit" name=""/>
    <bpmn:sequenceFlow id="Flow6" sourceRef="Resubmit" targetRef="Wait" name=""/>
    <bpmn:sequenceFlow id="Flow7" sourceRef="Reply" targetRef="ReceiveContract" name="Договор">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow8" sourceRef="Reply" targetRef="ReceiveNotice" name="Отказ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Отказ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow9" sourceRef="ReceiveContract" targetRef="ClientYes" name=""/>
    <bpmn:sequenceFlow id="Flow10" sourceRef="ReceiveNotice" targetRef="ClientNo" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_CompanyPool" name="Энергоснабжающая компания" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Operator" name="Оператор">
        <bpmn:flowNodeRef>CompanyStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Correction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Legal" name="Юридический отдел">
        <bpmn:flowNodeRef>LegalCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Security" name="Служба безопасности">
        <bpmn:flowNodeRef>SecurityCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Head" name="Руководитель">
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Manager" name="Менеджер">
        <bpmn:flowNodeRef>Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompanyYes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompanyNo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CompanyStart" name="Получена заявка">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>Flow11</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Merge" name="Проверка документов" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow11</bpmn:incoming>
      <bpmn:incoming>Flow12</bpmn:incoming>
      <bpmn:outgoing>Flow13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Check" name="Проверить документы">
      <bpmn:documentation>Оператор проверяет документы</bpmn:documentation>
      <bpmn:incoming>Flow13</bpmn:incoming>
      <bpmn:outgoing>Flow14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Complete" name="Документы полные?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow14</bpmn:incoming>
      <bpmn:outgoing>Flow15</bpmn:outgoing>
      <bpmn:outgoing>Flow17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Return" name="Вернуть заявку на доработку">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow15</bpmn:incoming>
      <bpmn:outgoing>Flow16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Correction" name="Получить исправленные документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow16</bpmn:incoming>
      <bpmn:outgoing>Flow12</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="Fork" name="Параллельные проверки" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow17</bpmn:incoming>
      <bpmn:outgoing>Flow18</bpmn:outgoing>
      <bpmn:outgoing>Flow19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="LegalCheck" name="Проверить заявку">
      <bpmn:documentation>После получения корректных документов заявку проверяют юридический отдел и служба безопасности</bpmn:documentation>
      <bpmn:incoming>Flow18</bpmn:incoming>
      <bpmn:outgoing>Flow20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SecurityCheck" name="Проверить заявку">
      <bpmn:documentation>После получения корректных документов заявку проверяют юридический отдел и служба безопасности</bpmn:documentation>
      <bpmn:incoming>Flow19</bpmn:incoming>
      <bpmn:outgoing>Flow21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Join" name="Проверки завершены" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow20</bpmn:incoming>
      <bpmn:incoming>Flow21</bpmn:incoming>
      <bpmn:outgoing>Flow22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Decide" name="Принять решение">
      <bpmn:documentation>Затем руководитель принимает решение</bpmn:documentation>
      <bpmn:incoming>Flow22</bpmn:incoming>
      <bpmn:outgoing>Flow23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Approved" name="Заявка одобрена?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow23</bpmn:incoming>
      <bpmn:outgoing>Flow24</bpmn:outgoing>
      <bpmn:outgoing>Flow25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Contract" name="Сформировать договор">
      <bpmn:documentation>Если заявка одобрена, менеджер формирует договор и отправляет его клиенту</bpmn:documentation>
      <bpmn:incoming>Flow24</bpmn:incoming>
      <bpmn:outgoing>Flow26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Send" name="Отправить договор клиенту">
      <bpmn:documentation>Если заявка одобрена, менеджер формирует договор и отправляет его клиенту</bpmn:documentation>
      <bpmn:incoming>Flow26</bpmn:incoming>
      <bpmn:outgoing>Flow27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Reject" name="Отправить уведомление об отказе">
      <bpmn:documentation>Если заявка отклонена, клиент получает уведомление об отказе.</bpmn:documentation>
      <bpmn:incoming>Flow25</bpmn:incoming>
      <bpmn:outgoing>Flow28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="CompanyYes" name="Договор отправлен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CompanyNo" name="Отказ отправлен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow11" sourceRef="CompanyStart" targetRef="Merge" name=""/>
    <bpmn:sequenceFlow id="Flow12" sourceRef="Correction" targetRef="Merge" name=""/>
    <bpmn:sequenceFlow id="Flow13" sourceRef="Merge" targetRef="Check" name=""/>
    <bpmn:sequenceFlow id="Flow14" sourceRef="Check" targetRef="Complete" name=""/>
    <bpmn:sequenceFlow id="Flow15" sourceRef="Complete" targetRef="Return" name="Документы неполные">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Документы неполные</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow16" sourceRef="Return" targetRef="Correction" name=""/>
    <bpmn:sequenceFlow id="Flow17" sourceRef="Complete" targetRef="Fork" name="Документы полные">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Документы полные</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow18" sourceRef="Fork" targetRef="LegalCheck" name=""/>
    <bpmn:sequenceFlow id="Flow19" sourceRef="Fork" targetRef="SecurityCheck" name=""/>
    <bpmn:sequenceFlow id="Flow20" sourceRef="LegalCheck" targetRef="Join" name=""/>
    <bpmn:sequenceFlow id="Flow21" sourceRef="SecurityCheck" targetRef="Join" name=""/>
    <bpmn:sequenceFlow id="Flow22" sourceRef="Join" targetRef="Decide" name=""/>
    <bpmn:sequenceFlow id="Flow23" sourceRef="Decide" targetRef="Approved" name=""/>
    <bpmn:sequenceFlow id="Flow24" sourceRef="Approved" targetRef="Contract" name="Одобрено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Одобрено</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow25" sourceRef="Approved" targetRef="Reject" name="Отклонено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Отклонено</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow26" sourceRef="Contract" targetRef="Send" name=""/>
    <bpmn:sequenceFlow id="Flow27" sourceRef="Send" targetRef="CompanyYes" name=""/>
    <bpmn:sequenceFlow id="Flow28" sourceRef="Reject" targetRef="CompanyNo" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="Connection" name="Подключение объекта">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта. Оператор проверяет документы. Если документов не хватает, заявку возвращают клиенту на доработку. После получения корректных документов заявку проверяют юридический отдел и служба безопасности. Затем руководитель принимает решение. Если заявка одобрена, менеджер формирует договор и отправляет его клиенту. Если заявка отклонена, клиент получает уведомление об отказе.</bpmn:documentation>
    <bpmn:participant id="ClientPool" name="Клиент" processRef="Process_ClientPool">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "Client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "ClientPool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="CompanyPool" name="Энергоснабжающая компания" processRef="Process_CompanyPool">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "Operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "CompanyPool"}, {"id": "Legal", "name": "Юридический отдел", "type": "role", "kind": "internal", "pool_id": "CompanyPool"}, {"id": "Security", "name": "Служба безопасности", "type": "role", "kind": "internal", "pool_id": "CompanyPool"}, {"id": "Head", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "CompanyPool"}, {"id": "Manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "CompanyPool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="Message0" sourceRef="Submit" targetRef="CompanyStart" name=""/>
    <bpmn:messageFlow id="Message1" sourceRef="Return" targetRef="ReceiveReturn" name=""/>
    <bpmn:messageFlow id="Message2" sourceRef="Resubmit" targetRef="Correction" name=""/>
    <bpmn:messageFlow id="Message3" sourceRef="Send" targetRef="ReceiveContract" name=""/>
    <bpmn:messageFlow id="Message4" sourceRef="Reject" targetRef="ReceiveNotice" name=""/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Connection">
      <bpmndi:BPMNShape id="Shape_ClientPool" bpmnElement="ClientPool" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="2990" height="275"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CompanyPool" bpmnElement="CompanyPool" isHorizontal="true">
        <dc:Bounds x="60" y="415" width="2990" height="1015"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Operator" bpmnElement="Operator" isHorizontal="true">
        <dc:Bounds x="90" y="415" width="2960" height="275"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Legal" bpmnElement="Legal" isHorizontal="true">
        <dc:Bounds x="90" y="690" width="2960" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Security" bpmnElement="Security" isHorizontal="true">
        <dc:Bounds x="90" y="845" width="2960" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Head" bpmnElement="Head" isHorizontal="true">
        <dc:Bounds x="90" y="1000" width="2960" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Manager" bpmnElement="Manager" isHorizontal="true">
        <dc:Bounds x="90" y="1155" width="2960" height="275"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ClientStart" bpmnElement="ClientStart">
        <dc:Bounds x="241.0" y="188.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
