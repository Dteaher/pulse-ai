<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_pool_client" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Начало процесса">
      <bpmn:documentation>Клиент подаёт заявку на заключение договора.</bpmn:documentation>
      <bpmn:outgoing>f_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_submit" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на заключение договора.</bpmn:documentation>
      <bpmn:incoming>f_c1</bpmn:incoming>
      <bpmn:outgoing>f_c2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="c_merge" name="Объединить возврат и первоначальную отправку" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f_c2</bpmn:incoming>
      <bpmn:incoming>f_c7</bpmn:incoming>
      <bpmn:outgoing>f_c3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="c_wait" name="Ожидать ответ" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f_c3</bpmn:incoming>
      <bpmn:outgoing>f_c4</bpmn:outgoing>
      <bpmn:outgoing>f_c8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="c_corr" name="Получить заявку на исправление">
      <bpmn:documentation>заявку возвращают клиенту на исправление</bpmn:documentation>
      <bpmn:incoming>f_c4</bpmn:incoming>
      <bpmn:outgoing>f_c5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_fix" name="Исправить документы">
      <bpmn:documentation>После исправления клиент повторно отправляет документы.</bpmn:documentation>
      <bpmn:incoming>f_c5</bpmn:incoming>
      <bpmn:outgoing>f_c6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_resubmit" name="Повторно отправить документы">
      <bpmn:documentation>клиент повторно отправляет документы</bpmn:documentation>
      <bpmn:incoming>f_c6</bpmn:incoming>
      <bpmn:outgoing>f_c7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_contract" name="Получить договор">
      <bpmn:documentation>Клиент получает договор</bpmn:documentation>
      <bpmn:incoming>f_c8</bpmn:incoming>
      <bpmn:outgoing>f_c9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="c_end" name="Процесс завершён">
      <bpmn:documentation>процесс завершается</bpmn:documentation>
      <bpmn:incoming>f_c9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_c1" sourceRef="c_start" targetRef="c_submit" name=""/>
    <bpmn:sequenceFlow id="f_c2" sourceRef="c_submit" targetRef="c_merge" name=""/>
    <bpmn:sequenceFlow id="f_c3" sourceRef="c_merge" targetRef="c_wait" name=""/>
    <bpmn:sequenceFlow id="f_c4" sourceRef="c_wait" targetRef="c_corr" name=""/>
    <bpmn:sequenceFlow id="f_c5" sourceRef="c_corr" targetRef="c_fix" name=""/>
    <bpmn:sequenceFlow id="f_c6" sourceRef="c_fix" targetRef="c_resubmit" name=""/>
    <bpmn:sequenceFlow id="f_c7" sourceRef="c_resubmit" targetRef="c_merge" name=""/>
    <bpmn:sequenceFlow id="f_c8" sourceRef="c_wait" targetRef="c_contract" name=""/>
    <bpmn:sequenceFlow id="f_c9" sourceRef="c_contract" targetRef="c_end" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_pool_org" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_check_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_receive_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal" name="Юридический отдел">
        <bpmn:flowNodeRef>o_legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security" name="Служба безопасности">
        <bpmn:flowNodeRef>o_security</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Менеджер">
        <bpmn:flowNodeRef>o_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_cost_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_o_send_contract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Руководитель">
        <bpmn:flowNodeRef>o_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_approve_decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="o_start" name="Получена заявка">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Клиент подаёт заявку на заключение договора.", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:outgoing>f_o1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_o_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="o_check" name="Проверить документы">
      <bpmn:documentation>Оператор проверяет документы.</bpmn:documentation>
      <bpmn:incoming>f_o1</bpmn:incoming>
      <bpmn:incoming>f_o6</bpmn:incoming>
      <bpmn:outgoing>f_o2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_check_decision" name="Документы корректны?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o2</bpmn:incoming>
      <bpmn:outgoing>f_o3</bpmn:outgoing>
      <bpmn:outgoing>f_o4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_return" name="Вернуть заявку на исправление">
      <bpmn:documentation>заявку возвращают клиенту на исправление</bpmn:documentation>
      <bpmn:incoming>f_o3</bpmn:incoming>
      <bpmn:outgoing>f_o5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_receive_fix" name="Получить исправленные документы">
      <bpmn:documentation>После исправления клиент повторно отправляет документы.</bpmn:documentation>
      <bpmn:incoming>f_o5</bpmn:incoming>
      <bpmn:outgoing>f_o6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="o_parallel_split" name="Начать одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно выполняют проверки</bpmn:documentation>
      <bpmn:incoming>f_o4</bpmn:incoming>
      <bpmn:outgoing>f_o7</bpmn:outgoing>
      <bpmn:outgoing>f_o8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_legal" name="Выполнить юридическую проверку">
      <bpmn:documentation>юридический отдел ... выполняют проверки</bpmn:documentation>
      <bpmn:incoming>f_o7</bpmn:incoming>
      <bpmn:outgoing>f_o9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="o_security" name="Выполнить проверку безопасности">
      <bpmn:documentation>служба безопасности одновременно выполняют проверки</bpmn:documentation>
      <bpmn:incoming>f_o8</bpmn:incoming>
      <bpmn:outgoing>f_o10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="o_parallel_join" name="Завершить обе проверки" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок</bpmn:documentation>
      <bpmn:incoming>f_o9</bpmn:incoming>
      <bpmn:incoming>f_o10</bpmn:incoming>
      <bpmn:outgoing>f_o11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_cost" name="Определить стоимость договора">
      <bpmn:documentation>менеджер определяет стоимость договора</bpmn:documentation>
      <bpmn:incoming>f_o11</bpmn:incoming>
      <bpmn:outgoing>f_o12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_cost_decision" name="Стоимость больше 500 000 рублей?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o12</bpmn:incoming>
      <bpmn:outgoing>f_o13</bpmn:outgoing>
      <bpmn:outgoing>f_o14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="o_approve" name="Согласовать договор">
      <bpmn:documentation>договор должен согласовать руководитель</bpmn:documentation>
      <bpmn:incoming>f_o13</bpmn:incoming>
      <bpmn:incoming>f_o18</bpmn:incoming>
      <bpmn:outgoing>f_o15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_approve_decision" name="Решение руководителя" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o15</bpmn:incoming>
      <bpmn:outgoing>f_o16</bpmn:outgoing>
      <bpmn:outgoing>f_o17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="o_rework" name="Доработать договор и повторно отправить на согласование">
      <bpmn:documentation>менеджер дорабатывает его и повторно отправляет на согласование</bpmn:documentation>
      <bpmn:incoming>f_o17</bpmn:incoming>
      <bpmn:outgoing>f_o18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>менеджер отправляет договор клиенту</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_o_send_contract</bpmn:incoming>
      <bpmn:outgoing>f_o19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="o_end" name="Процесс завершён">
      <bpmn:documentation>процесс завершается</bpmn:documentation>
      <bpmn:incoming>f_o19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_o_send_contract" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o14</bpmn:incoming>
      <bpmn:incoming>f_o16</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_o_send_contract</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f_o1" sourceRef="o_start" targetRef="o_check" name=""/>
    <bpmn:sequenceFlow id="f_o2" sourceRef="o_check" targetRef="o_check_decision" name=""/>
    <bpmn:sequenceFlow id="f_o3" sourceRef="o_check_decision" targetRef="o_return" name="Нужны исправления">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">документы заполнены неправильно</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o4" sourceRef="o_check_decision" targetRef="o_parallel_split" name="Документы корректны">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">документы заполнены правильно</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o5" sourceRef="o_return" targetRef="o_receive_fix" name=""/>
    <bpmn:sequenceFlow id="f_o6" sourceRef="o_receive_fix" targetRef="o_check" name=""/>
    <bpmn:sequenceFlow id="f_o7" sourceRef="o_parallel_split" targetRef="o_legal" name=""/>
    <bpmn:sequenceFlow id="f_o8" sourceRef="o_parallel_split" targetRef="o_security" name=""/>
    <bpmn:sequenceFlow id="f_o9" sourceRef="o_legal" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f_o10" sourceRef="o_security" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f_o11" sourceRef="o_parallel_join" targetRef="o_cost" name=""/>
    <bpmn:sequenceFlow id="f_o12" sourceRef="o_cost" targetRef="o_cost_decision" name=""/>
    <bpmn:sequenceFlow id="f_o13" sourceRef="o_cost_decision" targetRef="o_approve" name="Требуется согласование">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">стоимость больше 500 000 рублей</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o14" sourceRef="o_cost_decision" targetRef="Merge_o_send_contract" name="Согласование не требуется">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">стоимость не превышает 500 000 рублей</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o15" sourceRef="o_approve" targetRef="o_approve_decision" name=""/>
    <bpmn:sequenceFlow id="f_o16" sourceRef="o_approve_decision" targetRef="Merge_o_send_contract" name="Согласовано">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">руководитель согласовал договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o17" sourceRef="o_approve_decision" targetRef="o_rework" name="Отклонено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">руководитель отклонил договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o18" sourceRef="o_rework" targetRef="o_approve" name=""/>
    <bpmn:sequenceFlow id="f_o19" sourceRef="o_send_contract" targetRef="o_end" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_o_send_contract" sourceRef="Merge_o_send_contract" targetRef="o_send_contract" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="process_contract" name="Заключение договора">
    <bpmn:documentation>Клиент подаёт заявку на заключение договора. Оператор проверяет документы. Если документы заполнены неправильно, заявку возвращают клиенту на исправление. После исправления клиент повторно отправляет документы. Если всё корректно, юридический отдел и служба безопасности одновременно выполняют проверки. После завершения обеих проверок менеджер определяет стоимость договора. Если стоимость больше 500 000 рублей, договор должен согласовать руководитель. Если руководитель отклоняет договор, менеджер дорабатывает его и повторно отправляет на согласование. Если стоимость не превышает 500 000 рублей или руководитель согласовал договор, менеджер отправляет договор клиенту. Клиент получает договор, и процесс завершается.</bpmn:documentation>
    <bpmn:participant id="pool_client" name="Клиент" processRef="Process_pool_client">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "pool_client"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="pool_org" name="Организация" processRef="Process_pool_org">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "legal", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "security", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "supervisor", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "pool_org"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf1" sourceRef="c_submit" targetRef="o_start" name="Заявка"/>
    <bpmn:messageFlow id="mf2" sourceRef="o_return" targetRef="c_corr" name="Запрос на исправление"/>
    <bpmn:messageFlow id="mf3" sourceRef="c_resubmit" targetRef="o_receive_fix" name="Исправленные документы"/>
    <bpmn:messageFlow id="mf4" sourceRef="o_send_contract" targetRef="c_contract" name="Договор"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="process_contract">
      <bpmndi:BPMNShape id="Shape_pool_client" bpmnElement="pool_client" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="2800" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_pool_org" bpmnElement="pool_org" isHorizontal="true">
        <dc:Bounds x="60" y="390" width="2800" height="1340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_operator" bpmnElement="operator" isHorizontal="true">
        <dc:Bounds x="90" y="390" width="2770" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_legal" bpmnElement="legal" isHorizontal="true">
        <dc:Bounds x="90" y="730" width="2770" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_security" bpmnElement="security" isHorizontal="true">
        <dc:Bounds x="90" y="950" width="2770" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_manager" bpmnElement="manager" isHorizontal="true">
        <dc:Bounds x="90" y="1170" width="2770" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_supervisor" bpmnElement="supervisor" isHorizontal="true">
        <dc:Bounds x="90" y="1510" width="2770" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_start" bpmnElement="c_start">
        <dc:Bounds x="241.0" y="193.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_submit" bpmnElement="c_submit">
        <dc:Bounds x="380.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_merge" bpmnElement="c_merge">
        <dc:Bounds x="614.0" y="186.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_wait" bpmnElement="c_wait">
        <dc:Bounds x="804.0" y="186.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_corr" bpmnElement="c_corr">
        <dc:Bounds x="950.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_fix" bpmnElement="c_fix">
        <dc:Bounds x="1140.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_resubmit" bpmnElement="c_resubmit">
        <dc:Bounds x="1330.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_contract" bpmnElement="c_contract">
        <dc:Bounds x="2470.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c_end" bpmnElement="c_end">
        <dc:Bounds x="2711.0" y="193.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_o_start" bpmnElement="o_start">
        <dc:Bounds x="431.0" y="573.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_o_check" bpmnElement="o_check">
        <dc:Bounds x="570.0" y="552.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_o_check_decision" bpmnElement="o_check_decision">
        <dc:Bounds x="804.0" y="566.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
