# Inject credentials and a workspace access code (32+ characters) via Amvera settings.
APP_ENV=production
PRIMARY_LLM_PROVIDER=polza
PRIMARY_LLM_MODEL=openai/gpt-6-luna
PRIMARY_LLM_BASE_URL=https://polza.ai/api/v1
PRIMARY_LLM_API_KEY=
FALLBACK_LLM_PROVIDER=multiai
FALLBACK_LLM_MODEL=gpt-6-astra
FALLBACK_LLM_BASE_URL=https://multiai.store/v1
FALLBACK_LLM_API_KEY=
LLM_FALLBACK_ENABLED=true
LLM_STRUCTURED_OUTPUT=
LLM_PERFORMANCE_ENABLED=true
LLM_REASONING_EFFORT=low
LLM_BUSINESS_COVERAGE_REASONING_EFFORT=
LLM_BUSINESS_COVERAGE_ENABLED=true
LLM_TIMEOUT=120
LLM_CONNECT_TIMEOUT=30
LLM_REQUEST_BUDGET=360
LLM_FALLBACK_RESERVE=120
LLM_MAX_TOKENS=8000
LLM_PARSE_MAX_TOKENS=8000
LLM_CLARIFY_MAX_TOKENS=1500
LLM_DOCTOR_MAX_TOKENS=3000
LLM_MODIFY_MAX_TOKENS=8000
LLM_CORRECTIVE_MAX_TOKENS=8000
LLM_MAX_RETRIES=1
LLM_GRAPH_MAX_RETRIES=1
PRIMARY_LLM_OMIT_TOKEN_LIMIT=false
LLM_DEBUG_RAW_RESPONSE=false
API_LIMITS_ENABLED=true
PULSE_ACCESS_TOKEN=
LLM_TRUST_ENV=false
