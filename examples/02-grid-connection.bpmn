        <di:waypoint x="1315.0" y="887.5"/>
        <di:waypoint x="1374.0" y="887.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
