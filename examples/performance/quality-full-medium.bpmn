        <dc:Bounds x="804.0" y="575.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_request_additions" bpmnElement="request_additions">
        <dc:Bounds x="950.0" y="515.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_receive_additions" bpmnElement="receive_additions">
        <dc:Bounds x="1330.0" y="561.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_calculate_cost" bpmnElement="calculate_cost">
        <dc:Bounds x="950.0" y="607.3333333333334" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_prepare_contract" bpmnElement="prepare_contract">
        <dc:Bounds x="1140.0" y="561.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_manager_check" bpmnElement="manager_check">
        <dc:Bounds x="1330.0" y="841.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_approval_gateway" bpmnElement="approval_gateway">
        <dc:Bounds x="1564.0" y="855.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_contract" bpmnElement="send_contract">
        <dc:Bounds x="1710.0" y="515.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_correct_contract" bpmnElement="correct_contract">
        <dc:Bounds x="1710.0" y="607.3333333333334" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_resubmit_contract" bpmnElement="resubmit_contract">
        <dc:Bounds x="1900.0" y="561.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_receive_signed" bpmnElement="receive_signed">
        <dc:Bounds x="2090.0" y="561.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_archive_contract" bpmnElement="archive_contract">
        <dc:Bounds x="2280.0" y="561.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_company_end" bpmnElement="company_end">
        <dc:Bounds x="2521.0" y="582.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_client_start" bpmnElement="client_start">
        <dc:Bounds x="241.0" y="193.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_submit_application" bpmnElement="submit_application">
        <dc:Bounds x="380.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_client_wait" bpmnElement="client_wait">
        <dc:Bounds x="804.0" y="186.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_receive_addition_request" bpmnElement="receive_addition_request">
        <dc:Bounds x="950.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_provide_additions" bpmnElement="provide_additions">
        <dc:Bounds x="1140.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_additions" bpmnElement="send_additions">
        <dc:Bounds x="1330.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_receive_contract" bpmnElement="receive_contract">
        <dc:Bounds x="1710.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_sign_contract" bpmnElement="sign_contract">
        <dc:Bounds x="1900.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_signed_contract" bpmnElement="send_signed_contract">
        <dc:Bounds x="2090.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_client_end" bpmnElement="client_end">
        <dc:Bounds x="2331.0" y="193.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Merge_client_wait" bpmnElement="Merge_client_wait">
        <dc:Bounds x="614.0" y="186.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
