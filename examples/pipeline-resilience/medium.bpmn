        <dc:Bounds x="380.0" y="552.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_check_completeness" bpmnElement="check_completeness">
        <dc:Bounds x="570.0" y="552.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_completeness_gateway" bpmnElement="completeness_gateway">
        <dc:Bounds x="804.0" y="566.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_request_additions" bpmnElement="request_additions">
        <dc:Bounds x="950.0" y="506.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_receive_additions" bpmnElement="receive_additions">
        <dc:Bounds x="1140.0" y="506.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_calculate_cost" bpmnElement="calculate_cost">
        <dc:Bounds x="950.0" y="598.3333333333334" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_prepare_contract" bpmnElement="prepare_contract">
        <dc:Bounds x="1140.0" y="598.3333333333334" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_review_contract" bpmnElement="review_contract">
        <dc:Bounds x="1330.0" y="832.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_approval_gateway" bpmnElement="approval_gateway">
        <dc:Bounds x="1564.0" y="846.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_correct_contract" bpmnElement="correct_contract">
        <dc:Bounds x="1710.0" y="506.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_resend_contract" bpmnElement="resend_contract">
        <dc:Bounds x="1900.0" y="506.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_contract" bpmnElement="send_contract">
        <dc:Bounds x="1710.0" y="598.3333333333334" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_finish_processing" bpmnElement="finish_processing">
        <dc:Bounds x="1900.0" y="598.3333333333334" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_receive_signed_copy" bpmnElement="receive_signed_copy">
        <dc:Bounds x="2090.0" y="552.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_archive_copy" bpmnElement="archive_copy">
        <dc:Bounds x="2280.0" y="552.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_company" bpmnElement="end_company">
        <dc:Bounds x="2521.0" y="573.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_start_client" bpmnElement="start_client">
        <dc:Bounds x="1761.0" y="193.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_sign_contract" bpmnElement="sign_contract">
        <dc:Bounds x="1900.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_signed_copy" bpmnElement="send_signed_copy">
        <dc:Bounds x="2090.0" y="172.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end_client" bpmnElement="end_client">
        <dc:Bounds x="2331.0" y="193.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1">
