        <dc:Bounds x="1900.0" y="107.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndYes" bpmnElement="EndYes">
        <dc:Bounds x="2331.0" y="1023.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
