<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_client_pool" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="client_start" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>cf_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="submit_application" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:incoming>cf_01</bpmn:incoming>
      <bpmn:outgoing>cf_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="client_wait_gateway" name="Ожидать результат рассмотрения" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_client_wait_gateway</bpmn:incoming>
      <bpmn:outgoing>cf_03</bpmn:outgoing>
      <bpmn:outgoing>cf_04</bpmn:outgoing>
      <bpmn:outgoing>cf_14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="receive_returned_application" name="Получить заявку на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>cf_14</bpmn:incoming>
      <bpmn:outgoing>cf_15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="correct_documents" name="Исправить документы">
      <bpmn:documentation>Клиент исправляет документы</bpmn:documentation>
      <bpmn:incoming>cf_15</bpmn:incoming>
      <bpmn:outgoing>cf_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="resend_corrected_documents" name="Повторно отправить документы оператору">
      <bpmn:documentation>Клиент исправляет документы и повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>cf_16</bpmn:incoming>
      <bpmn:outgoing>cf_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_refusal" name="Получить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>cf_03</bpmn:incoming>
      <bpmn:outgoing>cf_05</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="client_end_refusal" name="Процесс завершён">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>cf_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="receive_contract" name="Получить договор">
      <bpmn:documentation>менеджер формирует договор и отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>cf_04</bpmn:incoming>
      <bpmn:outgoing>cf_06</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="check_contract" name="Проверить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>cf_06</bpmn:incoming>
      <bpmn:incoming>cf_11</bpmn:incoming>
      <bpmn:outgoing>cf_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="contract_agreement_gateway" name="Клиент согласен с условиями?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если клиент не согласен с условиями,", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>cf_07</bpmn:incoming>
      <bpmn:outgoing>cf_08</bpmn:outgoing>
      <bpmn:outgoing>cf_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="return_contract" name="Вернуть договор менеджеру на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>cf_08</bpmn:incoming>
      <bpmn:outgoing>cf_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_revised_contract" name="Получить исправленный договор">
      <bpmn:documentation>Менеджер вносит изменения и повторно отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>cf_10</bpmn:incoming>
      <bpmn:outgoing>cf_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="sign_contract" name="Подписать договор">
      <bpmn:documentation>он подписывает договор и отправляет его менеджеру.</bpmn:documentation>
      <bpmn:incoming>cf_09</bpmn:incoming>
      <bpmn:outgoing>cf_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_signed_contract" name="Отправить подписанный договор менеджеру">
      <bpmn:documentation>он подписывает договор и отправляет его менеджеру.</bpmn:documentation>
      <bpmn:incoming>cf_12</bpmn:incoming>
      <bpmn:outgoing>cf_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="client_end_registered" name="Процесс завершён">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>cf_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_client_wait_gateway" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>cf_02</bpmn:incoming>
      <bpmn:incoming>cf_17</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_client_wait_gateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="cf_01" sourceRef="client_start" targetRef="submit_application" name=""/>
    <bpmn:sequenceFlow id="cf_02" sourceRef="submit_application" targetRef="Merge_client_wait_gateway" name=""/>
    <bpmn:sequenceFlow id="cf_03" sourceRef="client_wait_gateway" targetRef="receive_refusal" name=""/>
    <bpmn:sequenceFlow id="cf_04" sourceRef="client_wait_gateway" targetRef="receive_contract" name=""/>
    <bpmn:sequenceFlow id="cf_05" sourceRef="receive_refusal" targetRef="client_end_refusal" name=""/>
    <bpmn:sequenceFlow id="cf_06" sourceRef="receive_contract" targetRef="check_contract" name=""/>
    <bpmn:sequenceFlow id="cf_07" sourceRef="check_contract" targetRef="contract_agreement_gateway" name=""/>
    <bpmn:sequenceFlow id="cf_08" sourceRef="contract_agreement_gateway" targetRef="return_contract" name="Клиент не согласен с условиями">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент не согласен с условиями</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cf_09" sourceRef="contract_agreement_gateway" targetRef="sign_contract" name="Клиент согласен с условиями">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент согласен с условиями</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cf_10" sourceRef="return_contract" targetRef="receive_revised_contract" name=""/>
    <bpmn:sequenceFlow id="cf_11" sourceRef="receive_revised_contract" targetRef="check_contract" name=""/>
    <bpmn:sequenceFlow id="cf_12" sourceRef="sign_contract" targetRef="send_signed_contract" name=""/>
    <bpmn:sequenceFlow id="cf_13" sourceRef="send_signed_contract" targetRef="client_end_registered" name=""/>
    <bpmn:sequenceFlow id="cf_14" sourceRef="client_wait_gateway" targetRef="receive_returned_application" name=""/>
    <bpmn:sequenceFlow id="cf_15" sourceRef="receive_returned_application" targetRef="correct_documents" name=""/>
    <bpmn:sequenceFlow id="cf_16" sourceRef="correct_documents" targetRef="resend_corrected_documents" name=""/>
    <bpmn:sequenceFlow id="cf_17" sourceRef="resend_corrected_documents" targetRef="Merge_client_wait_gateway" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_client_wait_gateway" sourceRef="Merge_client_wait_gateway" targetRef="client_wait_gateway" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_organization_pool" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator_participant" name="Оператор">
        <bpmn:flowNodeRef>organization_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>documents_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_corrected_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_checks_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>organization_end_refusal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal_department_participant" name="Юридический отдел">
        <bpmn:flowNodeRef>legal_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security_service_participant" name="Служба безопасности">
        <bpmn:flowNodeRef>security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager_participant" name="Менеджер">
        <bpmn:flowNodeRef>form_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_wait_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_returned_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amend_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resend_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_signed_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>organization_end_registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_manager_wait_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor_participant" name="Руководитель">
        <bpmn:flowNodeRef>parallel_checks_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>make_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="organization_start" name="Получена заявка">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:outgoing>of_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_organization_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="check_documents" name="Проверить документы">
      <bpmn:documentation>Оператор получает заявку и проверяет документы.</bpmn:documentation>
      <bpmn:incoming>of_01</bpmn:incoming>
      <bpmn:incoming>of_05</bpmn:incoming>
      <bpmn:outgoing>of_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="documents_gateway" name="Документы корректны?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если документов не хватает или они заполнены неправильно,", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>of_02</bpmn:incoming>
      <bpmn:outgoing>of_03</bpmn:outgoing>
      <bpmn:outgoing>of_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="return_application" name="Вернуть заявку на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>of_03</bpmn:incoming>
      <bpmn:outgoing>of_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_corrected_documents" name="Получить исправленные документы">
      <bpmn:documentation>Клиент исправляет документы и повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>of_04</bpmn:incoming>
      <bpmn:outgoing>of_05</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="parallel_checks_split" name="Начать одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>of_06</bpmn:incoming>
      <bpmn:outgoing>of_07</bpmn:outgoing>
      <bpmn:outgoing>of_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="legal_check" name="Проверить заявку">
      <bpmn:documentation>юридический отдел ... проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>of_07</bpmn:incoming>
      <bpmn:outgoing>of_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="security_check" name="Проверить заявку">
      <bpmn:documentation>служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>of_08</bpmn:incoming>
      <bpmn:outgoing>of_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="parallel_checks_join" name="Проверки завершены" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок</bpmn:documentation>
      <bpmn:incoming>of_09</bpmn:incoming>
      <bpmn:incoming>of_10</bpmn:incoming>
      <bpmn:outgoing>of_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="make_decision" name="Принять решение">
      <bpmn:documentation>руководитель принимает решение.</bpmn:documentation>
      <bpmn:incoming>of_11</bpmn:incoming>
      <bpmn:outgoing>of_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="decision_gateway" name="Заявка одобрена?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если заявка отклонена, ... Если заявка одобрена,", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>of_12</bpmn:incoming>
      <bpmn:outgoing>of_13</bpmn:outgoing>
      <bpmn:outgoing>of_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="send_refusal" name="Отправить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе,</bpmn:documentation>
      <bpmn:incoming>of_13</bpmn:incoming>
      <bpmn:outgoing>of_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="organization_end_refusal" name="Процесс завершён">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>of_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="form_contract" name="Сформировать договор">
      <bpmn:documentation>менеджер формирует договор</bpmn:documentation>
      <bpmn:incoming>of_15</bpmn:incoming>
      <bpmn:outgoing>of_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>и отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>of_16</bpmn:incoming>
      <bpmn:outgoing>of_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="manager_wait_gateway" name="Ожидать ответ клиента" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_manager_wait_gateway</bpmn:incoming>
      <bpmn:outgoing>of_18</bpmn:outgoing>
      <bpmn:outgoing>of_19</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="receive_returned_contract" name="Получить договор на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>of_18</bpmn:incoming>
      <bpmn:outgoing>of_20</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="amend_contract" name="Внести изменения в договор">
      <bpmn:documentation>Менеджер вносит изменения</bpmn:documentation>
      <bpmn:incoming>of_20</bpmn:incoming>
      <bpmn:outgoing>of_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="resend_contract" name="Повторно отправить договор клиенту">
      <bpmn:documentation>и повторно отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>of_21</bpmn:incoming>
      <bpmn:outgoing>of_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_signed_contract" name="Получить подписанный договор">
      <bpmn:documentation>он подписывает договор и отправляет его менеджеру.</bpmn:documentation>
      <bpmn:incoming>of_19</bpmn:incoming>
      <bpmn:outgoing>of_23</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="register_contract" name="Зарегистрировать подписанный договор">
      <bpmn:documentation>Менеджер регистрирует подписанный договор,</bpmn:documentation>
      <bpmn:incoming>of_23</bpmn:incoming>
      <bpmn:outgoing>of_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="organization_end_registered" name="Процесс завершён">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>of_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_manager_wait_gateway" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>of_17</bpmn:incoming>
      <bpmn:incoming>of_22</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_manager_wait_gateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="of_01" sourceRef="organization_start" targetRef="check_documents" name=""/>
    <bpmn:sequenceFlow id="of_02" sourceRef="check_documents" targetRef="documents_gateway" name=""/>
    <bpmn:sequenceFlow id="of_03" sourceRef="documents_gateway" targetRef="return_application" name="Документы неполные или заполнены неправильно">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документов не хватает или они заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="of_04" sourceRef="return_application" targetRef="receive_corrected_documents" name=""/>
    <bpmn:sequenceFlow id="of_05" sourceRef="receive_corrected_documents" targetRef="check_documents" name=""/>
    <bpmn:sequenceFlow id="of_06" sourceRef="documents_gateway" targetRef="parallel_checks_split" name="Документы корректны">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="of_07" sourceRef="parallel_checks_split" targetRef="legal_check" name=""/>
    <bpmn:sequenceFlow id="of_08" sourceRef="parallel_checks_split" targetRef="security_check" name=""/>
    <bpmn:sequenceFlow id="of_09" sourceRef="legal_check" targetRef="parallel_checks_join" name=""/>
    <bpmn:sequenceFlow id="of_10" sourceRef="security_check" targetRef="parallel_checks_join" name=""/>
    <bpmn:sequenceFlow id="of_11" sourceRef="parallel_checks_join" targetRef="make_decision" name=""/>
    <bpmn:sequenceFlow id="of_12" sourceRef="make_decision" targetRef="decision_gateway" name=""/>
    <bpmn:sequenceFlow id="of_13" sourceRef="decision_gateway" targetRef="send_refusal" name="Заявка отклонена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="of_14" sourceRef="send_refusal" targetRef="organization_end_refusal" name=""/>
    <bpmn:sequenceFlow id="of_15" sourceRef="decision_gateway" targetRef="form_contract" name="Заявка одобрена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="of_16" sourceRef="form_contract" targetRef="send_contract" name=""/>
    <bpmn:sequenceFlow id="of_17" sourceRef="send_contract" targetRef="Merge_manager_wait_gateway" name=""/>
    <bpmn:sequenceFlow id="of_18" sourceRef="manager_wait_gateway" targetRef="receive_returned_contract" name=""/>
    <bpmn:sequenceFlow id="of_19" sourceRef="manager_wait_gateway" targetRef="receive_signed_contract" name=""/>
    <bpmn:sequenceFlow id="of_20" sourceRef="receive_returned_contract" targetRef="amend_contract" name=""/>
    <bpmn:sequenceFlow id="of_21" sourceRef="amend_contract" targetRef="resend_contract" name=""/>
    <bpmn:sequenceFlow id="of_22" sourceRef="resend_contract" targetRef="Merge_manager_wait_gateway" name=""/>
    <bpmn:sequenceFlow id="of_23" sourceRef="receive_signed_contract" targetRef="register_contract" name=""/>
    <bpmn:sequenceFlow id="of_24" sourceRef="register_contract" targetRef="organization_end_registered" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_manager_wait_gateway" sourceRef="Merge_manager_wait_gateway" targetRef="manager_wait_gateway" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="connection_application_process" name="Подключение объекта">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта.
Оператор получает заявку и проверяет документы.
Если документов не хватает или они заполнены неправильно,
оператор возвращает заявку клиенту на доработку.
Клиент исправляет документы и повторно отправляет их оператору.

Если документы корректны,
юридический отдел и служба безопасности одновременно проверяют заявку.
После завершения обеих проверок руководитель принимает решение.

Если заявка отклонена,
оператор отправляет клиенту уведомление об отказе,
после чего процесс завершается.

Если заявка одобрена,
менеджер формирует договор и отправляет его клиенту.

Клиент проверяет договор.
Если клиент не согласен с условиями,
он возвращает договор менеджеру на доработку.
Менеджер вносит изменения и повторно отправляет договор клиенту.

Если клиент согласен,
он подписывает договор и отправляет его менеджеру.
Менеджер регистрирует подписанный договор,
после чего процесс завершается.
</bpmn:documentation>
    <bpmn:participant id="client_pool" name="Клиент" processRef="Process_client_pool">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client_participant", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "client_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="organization_pool" name="Организация" processRef="Process_organization_pool">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator_participant", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "legal_department_participant", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "security_service_participant", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "manager_participant", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "supervisor_participant", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "organization_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf_01" sourceRef="submit_application" targetRef="organization_start" name="Заявка"/>
    <bpmn:messageFlow id="mf_02" sourceRef="return_application" targetRef="receive_returned_application" name="Заявка на доработку"/>
    <bpmn:messageFlow id="mf_03" sourceRef="return_contract" targetRef="receive_returned_contract" name="Договор на доработку"/>
    <bpmn:messageFlow id="mf_04" sourceRef="resend_contract" targetRef="receive_revised_contract" name="Исправленный договор"/>
    <bpmn:messageFlow id="mf_05" sourceRef="send_refusal" targetRef="receive_refusal" name="Уведомление об отказе"/>
    <bpmn:messageFlow id="mf_06" sourceRef="send_contract" targetRef="receive_contract" name="Договор"/>
    <bpmn:messageFlow id="mf_07" sourceRef="send_signed_contract" targetRef="receive_signed_contract" name="Подписанный договор"/>
    <bpmn:messageFlow id="mf_08" sourceRef="resend_corrected_documents" targetRef="receive_corrected_documents" name="Исправленные документы"/>
  </bpmn:collaboration>
