    <bpmn:sequenceFlow id="f_o20" sourceRef="o_get_revision" targetRef="o_change_contract" name=""/>
    <bpmn:sequenceFlow id="f_o21" sourceRef="o_change_contract" targetRef="o_resend_contract" name=""/>
