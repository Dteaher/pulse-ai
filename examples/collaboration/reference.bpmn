      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Wait" bpmnElement="Wait">
        <dc:Bounds x="570.0" y="167.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reply" bpmnElement="Reply">
        <dc:Bounds x="804.0" y="181.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReceiveReturn" bpmnElement="ReceiveReturn">
        <dc:Bounds x="1330.0" y="167.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Revise" bpmnElement="Revise">
        <dc:Bounds x="1520.0" y="167.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Resubmit" bpmnElement="Resubmit">
        <dc:Bounds x="1710.0" y="167.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReceiveContract" bpmnElement="ReceiveContract">
        <dc:Bounds x="2660.0" y="121.66666666666669" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReceiveNotice" bpmnElement="ReceiveNotice">
        <dc:Bounds x="2470.0" y="167.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ClientYes" bpmnElement="ClientYes">
        <dc:Bounds x="2901.0" y="188.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ClientNo" bpmnElement="ClientNo">
        <dc:Bounds x="2711.0" y="234.33333333333334" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CompanyStart" bpmnElement="CompanyStart">
        <dc:Bounds x="431.0" y="533.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Merge" bpmnElement="Merge">
        <dc:Bounds x="614.0" y="526.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check">
        <dc:Bounds x="760.0" y="512.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Complete" bpmnElement="Complete">
        <dc:Bounds x="994.0" y="526.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Return" bpmnElement="Return">
        <dc:Bounds x="1330.0" y="466.66666666666663" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Correction" bpmnElement="Correction">
        <dc:Bounds x="1710.0" y="512.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork" bpmnElement="Fork">
        <dc:Bounds x="1374.0" y="572.3333333333334" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LegalCheck" bpmnElement="LegalCheck">
        <dc:Bounds x="1520.0" y="727.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SecurityCheck" bpmnElement="SecurityCheck">
        <dc:Bounds x="1520.0" y="882.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Join" bpmnElement="Join">
        <dc:Bounds x="1754.0" y="1051.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Decide" bpmnElement="Decide">
        <dc:Bounds x="1900.0" y="1037.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Approved" bpmnElement="Approved">
        <dc:Bounds x="2134.0" y="1051.5" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Contract" bpmnElement="Contract">
        <dc:Bounds x="2470.0" y="1206.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Send" bpmnElement="Send">
        <dc:Bounds x="2660.0" y="1206.6666666666667" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reject" bpmnElement="Reject">
