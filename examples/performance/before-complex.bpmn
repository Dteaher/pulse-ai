<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_pool_client" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>f_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_submit" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:incoming>f_c1</bpmn:incoming>
      <bpmn:outgoing>f_c2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_wait" name="Ожидать сообщение" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_c_wait</bpmn:incoming>
      <bpmn:outgoing>f_c3</bpmn:outgoing>
      <bpmn:outgoing>f_c4</bpmn:outgoing>
      <bpmn:outgoing>f_c5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="c_get_correction" name="Получить запрос на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>f_c3</bpmn:incoming>
      <bpmn:outgoing>f_c6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_fix" name="Исправить документы">
      <bpmn:documentation>Клиент исправляет документы</bpmn:documentation>
      <bpmn:incoming>f_c6</bpmn:incoming>
      <bpmn:outgoing>f_c7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_resubmit" name="Повторно отправить документы">
      <bpmn:documentation>повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>f_c7</bpmn:incoming>
      <bpmn:outgoing>f_c8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_get_rejection" name="Получить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>f_c4</bpmn:incoming>
      <bpmn:outgoing>f_c9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="c_get_contract" name="Получить договор">
      <bpmn:documentation>отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>f_c5</bpmn:incoming>
      <bpmn:outgoing>f_c10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_check_contract" name="Проверить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>f_c10</bpmn:incoming>
      <bpmn:incoming>f_c15</bpmn:incoming>
      <bpmn:outgoing>f_c11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="c_contract_decision" name="Решить, согласен ли клиент с договором" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если клиент не согласен", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_c11</bpmn:incoming>
      <bpmn:outgoing>f_c12</bpmn:outgoing>
      <bpmn:outgoing>f_c13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="c_return_contract" name="Вернуть договор на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>f_c12</bpmn:incoming>
      <bpmn:outgoing>f_c14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_wait_revised" name="Получить изменённый договор">
      <bpmn:documentation>Менеджер изменяет договор и повторно отправляет клиенту.</bpmn:documentation>
      <bpmn:incoming>f_c14</bpmn:incoming>
      <bpmn:outgoing>f_c15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="c_sign_contract" name="Подписать договор и отправить менеджеру">
      <bpmn:documentation>он подписывает договор и отправляет менеджеру.</bpmn:documentation>
      <bpmn:incoming>f_c13</bpmn:incoming>
      <bpmn:outgoing>f_c16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="c_end_rejected" name="Процесс завершён после отказа">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f_c9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="c_end_signed" name="Процесс завершён после подписания">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f_c16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_c_wait" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_c2</bpmn:incoming>
      <bpmn:incoming>f_c8</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_c_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f_c1" sourceRef="c_start" targetRef="c_submit" name=""/>
    <bpmn:sequenceFlow id="f_c2" sourceRef="c_submit" targetRef="Merge_c_wait" name=""/>
    <bpmn:sequenceFlow id="f_c3" sourceRef="c_wait" targetRef="c_get_correction" name=""/>
    <bpmn:sequenceFlow id="f_c4" sourceRef="c_wait" targetRef="c_get_rejection" name=""/>
    <bpmn:sequenceFlow id="f_c5" sourceRef="c_wait" targetRef="c_get_contract" name=""/>
    <bpmn:sequenceFlow id="f_c6" sourceRef="c_get_correction" targetRef="c_fix" name=""/>
    <bpmn:sequenceFlow id="f_c7" sourceRef="c_fix" targetRef="c_resubmit" name=""/>
    <bpmn:sequenceFlow id="f_c8" sourceRef="c_resubmit" targetRef="Merge_c_wait" name=""/>
    <bpmn:sequenceFlow id="f_c9" sourceRef="c_get_rejection" targetRef="c_end_rejected" name=""/>
    <bpmn:sequenceFlow id="f_c10" sourceRef="c_get_contract" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="f_c11" sourceRef="c_check_contract" targetRef="c_contract_decision" name=""/>
    <bpmn:sequenceFlow id="f_c12" sourceRef="c_contract_decision" targetRef="c_return_contract" name="Не согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент не согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_c13" sourceRef="c_contract_decision" targetRef="c_sign_contract" name="Согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_c14" sourceRef="c_return_contract" targetRef="c_wait_revised" name=""/>
    <bpmn:sequenceFlow id="f_c15" sourceRef="c_wait_revised" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="f_c16" sourceRef="c_sign_contract" targetRef="c_end_signed" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_c_wait" sourceRef="Merge_c_wait" targetRef="c_wait" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_pool_org" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_check_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_doc_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_return_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait_corrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_legal_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal" name="Юридический отдел">
        <bpmn:flowNodeRef>o_legal_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security" name="Служба безопасности">
        <bpmn:flowNodeRef>o_security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Руководитель">
        <bpmn:flowNodeRef>o_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_decision_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Менеджер">
        <bpmn:flowNodeRef>o_form_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_contract_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_returned_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_change_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_resend_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_signed_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_register_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_o_contract_wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="o_start" name="Получено сообщение: Заявка">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:outgoing>f_o1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_o_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="o_check_documents" name="Проверить документы">
      <bpmn:documentation>проверяет документы.</bpmn:documentation>
      <bpmn:incoming>f_o1</bpmn:incoming>
      <bpmn:incoming>f_o6</bpmn:incoming>
      <bpmn:outgoing>f_o2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_doc_decision" name="Проверить результат проверки документов" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o2</bpmn:incoming>
      <bpmn:outgoing>f_o3</bpmn:outgoing>
      <bpmn:outgoing>f_o4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_return_application" name="Вернуть заявку на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>f_o3</bpmn:incoming>
      <bpmn:outgoing>f_o5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_wait_corrected" name="Получить исправленные документы">
      <bpmn:documentation>Клиент исправляет документы и повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>f_o5</bpmn:incoming>
      <bpmn:outgoing>f_o6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_legal_check" name="Передать заявку на проверки">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f_o4</bpmn:incoming>
      <bpmn:outgoing>f_o7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="o_parallel_split" name="Начать одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f_o7</bpmn:incoming>
      <bpmn:outgoing>f_o8</bpmn:outgoing>
      <bpmn:outgoing>f_o9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_legal_review" name="Проверить заявку">
      <bpmn:documentation>юридический отдел ... одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f_o9</bpmn:incoming>
      <bpmn:outgoing>f_o11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="o_security_check" name="Проверить заявку">
      <bpmn:documentation>служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f_o8</bpmn:incoming>
      <bpmn:outgoing>f_o10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="o_parallel_join" name="Завершить одновременные проверки" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f_o10</bpmn:incoming>
      <bpmn:incoming>f_o11</bpmn:incoming>
      <bpmn:outgoing>f_o12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_decide" name="Принять решение по заявке">
      <bpmn:documentation>руководитель принимает решение.</bpmn:documentation>
      <bpmn:incoming>f_o12</bpmn:incoming>
      <bpmn:outgoing>f_o13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_decision_gateway" name="Результат решения" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o13</bpmn:incoming>
      <bpmn:outgoing>f_o14</bpmn:outgoing>
      <bpmn:outgoing>f_o15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_send_rejection" name="Отправить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>f_o14</bpmn:incoming>
      <bpmn:outgoing>f_o16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="o_form_contract" name="Сформировать договор">
      <bpmn:documentation>менеджер формирует договор</bpmn:documentation>
      <bpmn:incoming>f_o15</bpmn:incoming>
      <bpmn:outgoing>f_o17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>f_o17</bpmn:incoming>
      <bpmn:outgoing>f_o18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="o_contract_wait" name="Ожидать ответ клиента" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_o_contract_wait</bpmn:incoming>
      <bpmn:outgoing>f_o19</bpmn:outgoing>
      <bpmn:outgoing>f_o20</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="o_get_returned_contract" name="Получить договор на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>f_o19</bpmn:incoming>
      <bpmn:outgoing>f_o21</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_change_contract" name="Изменить договор">
      <bpmn:documentation>Менеджер изменяет договор</bpmn:documentation>
      <bpmn:incoming>f_o21</bpmn:incoming>
      <bpmn:outgoing>f_o22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_resend_contract" name="Повторно отправить договор клиенту">
      <bpmn:documentation>повторно отправляет клиенту.</bpmn:documentation>
      <bpmn:incoming>f_o22</bpmn:incoming>
      <bpmn:outgoing>f_o23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_get_signed_contract" name="Получить подписанный договор">
      <bpmn:documentation>отправляет менеджеру.</bpmn:documentation>
      <bpmn:incoming>f_o20</bpmn:incoming>
      <bpmn:outgoing>f_o24</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_register_contract" name="Зарегистрировать договор">
      <bpmn:documentation>Менеджер регистрирует договор</bpmn:documentation>
      <bpmn:incoming>f_o24</bpmn:incoming>
      <bpmn:outgoing>f_o25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="o_end_rejected" name="Процесс завершён после отказа">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f_o16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="o_end_registered" name="Процесс завершён после регистрации">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f_o25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_o_contract_wait" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o18</bpmn:incoming>
      <bpmn:incoming>f_o23</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_o_contract_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f_o1" sourceRef="o_start" targetRef="o_check_documents" name=""/>
    <bpmn:sequenceFlow id="f_o2" sourceRef="o_check_documents" targetRef="o_doc_decision" name=""/>
    <bpmn:sequenceFlow id="f_o3" sourceRef="o_doc_decision" targetRef="o_return_application" name="Документы требуют доработки">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документов не хватает или они заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o4" sourceRef="o_doc_decision" targetRef="o_legal_check" name="Документы корректны">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o5" sourceRef="o_return_application" targetRef="o_wait_corrected" name=""/>
    <bpmn:sequenceFlow id="f_o6" sourceRef="o_wait_corrected" targetRef="o_check_documents" name=""/>
    <bpmn:sequenceFlow id="f_o7" sourceRef="o_legal_check" targetRef="o_parallel_split" name=""/>
    <bpmn:sequenceFlow id="f_o8" sourceRef="o_parallel_split" targetRef="o_security_check" name=""/>
    <bpmn:sequenceFlow id="f_o9" sourceRef="o_parallel_split" targetRef="o_legal_review" name=""/>
    <bpmn:sequenceFlow id="f_o10" sourceRef="o_security_check" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f_o11" sourceRef="o_legal_review" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f_o12" sourceRef="o_parallel_join" targetRef="o_decide" name=""/>
    <bpmn:sequenceFlow id="f_o13" sourceRef="o_decide" targetRef="o_decision_gateway" name=""/>
    <bpmn:sequenceFlow id="f_o14" sourceRef="o_decision_gateway" targetRef="o_send_rejection" name="Отклонена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o15" sourceRef="o_decision_gateway" targetRef="o_form_contract" name="Одобрена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o16" sourceRef="o_send_rejection" targetRef="o_end_rejected" name=""/>
    <bpmn:sequenceFlow id="f_o17" sourceRef="o_form_contract" targetRef="o_send_contract" name=""/>
    <bpmn:sequenceFlow id="f_o18" sourceRef="o_send_contract" targetRef="Merge_o_contract_wait" name=""/>
    <bpmn:sequenceFlow id="f_o19" sourceRef="o_contract_wait" targetRef="o_get_returned_contract" name=""/>
    <bpmn:sequenceFlow id="f_o20" sourceRef="o_contract_wait" targetRef="o_get_signed_contract" name=""/>
    <bpmn:sequenceFlow id="f_o21" sourceRef="o_get_returned_contract" targetRef="o_change_contract" name=""/>
    <bpmn:sequenceFlow id="f_o22" sourceRef="o_change_contract" targetRef="o_resend_contract" name=""/>
    <bpmn:sequenceFlow id="f_o23" sourceRef="o_resend_contract" targetRef="Merge_o_contract_wait" name=""/>
    <bpmn:sequenceFlow id="f_o24" sourceRef="o_get_signed_contract" targetRef="o_register_contract" name=""/>
    <bpmn:sequenceFlow id="f_o25" sourceRef="o_register_contract" targetRef="o_end_registered" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_o_contract_wait" sourceRef="Merge_o_contract_wait" targetRef="o_contract_wait" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="process_connection" name="Подключение объекта">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта.
Оператор получает заявку и проверяет документы.
Если документов не хватает или они заполнены неправильно,
оператор возвращает заявку клиенту на доработку.
Клиент исправляет документы и повторно отправляет их оператору.

Если документы корректны,
юридический отдел и служба безопасности одновременно проверяют заявку.
После завершения обеих проверок руководитель принимает решение.

Если заявка отклонена,
оператор отправляет клиенту уведомление об отказе,
после чего процесс завершается.

Если заявка одобрена,
менеджер формирует договор и отправляет его клиенту.

Клиент проверяет договор.
Если клиент не согласен,
он возвращает договор менеджеру на доработку.
Менеджер изменяет договор и повторно отправляет клиенту.

Если клиент согласен,
он подписывает договор и отправляет менеджеру.
Менеджер регистрирует договор,
после чего процесс завершается.</bpmn:documentation>
    <bpmn:participant id="pool_client" name="Клиент" processRef="Process_pool_client">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "pool_client"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="pool_org" name="Организация" processRef="Process_pool_org">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "legal", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "security", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "head", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "pool_org"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf1" sourceRef="c_submit" targetRef="o_start" name="Заявка"/>
    <bpmn:messageFlow id="mf2" sourceRef="o_return_application" targetRef="c_get_correction" name="Запрос на доработку"/>
    <bpmn:messageFlow id="mf3" sourceRef="c_resubmit" targetRef="o_wait_corrected" name="Исправленные документы"/>
    <bpmn:messageFlow id="mf4" sourceRef="o_send_rejection" targetRef="c_get_rejection" name="Уведомление об отказе"/>
    <bpmn:messageFlow id="mf5" sourceRef="o_send_contract" targetRef="c_get_contract" name="Договор"/>
    <bpmn:messageFlow id="mf6" sourceRef="c_return_contract" targetRef="o_get_returned_contract" name="Договор на доработку"/>
    <bpmn:messageFlow id="mf7" sourceRef="o_resend_contract" targetRef="c_wait_revised" name="Доработанный договор"/>
    <bpmn:messageFlow id="mf8" sourceRef="c_sign_contract" targetRef="o_get_signed_contract" name="Подписанный договор"/>
  </bpmn:collaboration>
