<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.1">
  <bpmn:process id="Process_Connection" name="Подключение к электросети" isExecutable="false">
    <bpmn:documentation>Клиент отправляет заявку на подключение. Оператор проверяет документы. Если документов не хватает, оператор возвращает заявку клиенту на доработку. После получения корректных документов заявку одновременно проверяют юридический отдел и служба безопасности. После завершения обеих проверок руководитель принимает решение. Если заявка одобрена, менеджер готовит договор и отправляет его клиенту. Если заявка отклонена, клиент получает уведомление об отказе.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Client" name="Клиент">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Operator" name="Оператор">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Legal" name="Юридический отдел">
        <bpmn:flowNodeRef>LegalCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Security" name="Служба безопасности">
        <bpmn:flowNodeRef>SecurityCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Head" name="Руководитель">
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Manager" name="Менеджер">
        <bpmn:flowNodeRef>Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndYes</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Потребность в подключении">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Submit" name="Отправить заявку">
      <bpmn:documentation>Клиент отправляет заявку на подключение</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Check" name="Проверить документы">
      <bpmn:documentation>Оператор проверяет документы</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Complete" name="Документы полные?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Return" name="Вернуть на доработку">
      <bpmn:documentation>Если документов не хватает, оператор возвращает заявку клиенту на доработку</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Revise" name="Дополнить документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Fork" name="Начать проверки" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="LegalCheck" name="Юридическая проверка">
      <bpmn:documentation>После получения корректных документов заявку одновременно проверяют юридический отдел и служба безопасности</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SecurityCheck" name="Проверка безопасности">
      <bpmn:documentation>После получения корректных документов заявку одновременно проверяют юридический отдел и служба безопасности</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Join" name="Проверки завершены" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Decide" name="Принять решение">
      <bpmn:documentation>После завершения обеих проверок руководитель принимает решение</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Approved" name="Заявка одобрена?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Contract" name="Подготовить договор">
      <bpmn:documentation>Если заявка одобрена, менеджер готовит договор и отправляет его клиенту</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Send" name="Отправить договор">
      <bpmn:documentation>Если заявка одобрена, менеджер готовит договор и отправляет его клиенту</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Reject" name="Уведомить об отказе">
      <bpmn:documentation>Если заявка отклонена, клиент получает уведомление об отказе.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndYes" name="Договор отправлен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndNo" name="Отказ получен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Submit" name=""/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Submit" targetRef="Check" name=""/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Check" targetRef="Complete" name=""/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Complete" targetRef="Return" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Return" targetRef="Revise" name=""/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Revise" targetRef="Check" name=""/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Complete" targetRef="Fork" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Fork" targetRef="LegalCheck" name=""/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Fork" targetRef="SecurityCheck" name=""/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="LegalCheck" targetRef="Join" name=""/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="SecurityCheck" targetRef="Join" name=""/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Join" targetRef="Decide" name=""/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Decide" targetRef="Approved" name=""/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Approved" targetRef="Contract" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Approved" targetRef="Reject" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Contract" targetRef="Send" name=""/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Send" targetRef="EndYes" name=""/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Reject" targetRef="EndNo" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Подключение к электросети" processRef="Process_Connection"/>
  </bpmn:collaboration>
