<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_client_pool" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_submit" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_wait" name="Ожидать ответ" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_c_wait</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
      <bpmn:outgoing>f04</bpmn:outgoing>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="c_receive_rework" name="Получить запрос на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="c_receive_refusal" name="Получить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="c_receive_contract" name="Получить договор">
      <bpmn:documentation>менеджер формирует договор и отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_correct" name="Исправить документы">
      <bpmn:documentation>Клиент исправляет документы</bpmn:documentation>
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_resend_docs" name="Повторно отправить документы">
      <bpmn:documentation>повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="c_check_contract" name="Проверить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="c_contract_decision" name="Решение по условиям договора" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если клиент не согласен с условиями,... Если клиент согласен,", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="c_return_contract" name="Вернуть договор менеджеру на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_receive_modified_contract" name="Получить доработанный договор">
      <bpmn:documentation>Менеджер ... повторно отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_sign_contract" name="Подписать договор">
      <bpmn:documentation>он подписывает договор</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_send_signed" name="Отправить подписанный договор">
      <bpmn:documentation>отправляет его менеджеру.</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="c_end_refusal" name="Процесс завершён после отказа">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="c_end_signed" name="Процесс завершён">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_c_wait" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_c_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f01" sourceRef="c_start" targetRef="c_submit" name=""/>
    <bpmn:sequenceFlow id="f02" sourceRef="c_submit" targetRef="Merge_c_wait" name=""/>
    <bpmn:sequenceFlow id="f03" sourceRef="c_wait" targetRef="c_receive_rework" name=""/>
    <bpmn:sequenceFlow id="f04" sourceRef="c_wait" targetRef="c_receive_refusal" name=""/>
    <bpmn:sequenceFlow id="f05" sourceRef="c_wait" targetRef="c_receive_contract" name=""/>
    <bpmn:sequenceFlow id="f06" sourceRef="c_receive_rework" targetRef="c_correct" name=""/>
    <bpmn:sequenceFlow id="f07" sourceRef="c_correct" targetRef="c_resend_docs" name=""/>
    <bpmn:sequenceFlow id="f08" sourceRef="c_resend_docs" targetRef="Merge_c_wait" name=""/>
    <bpmn:sequenceFlow id="f09" sourceRef="c_receive_refusal" targetRef="c_end_refusal" name=""/>
    <bpmn:sequenceFlow id="f10" sourceRef="c_receive_contract" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="f11" sourceRef="c_check_contract" targetRef="c_contract_decision" name=""/>
    <bpmn:sequenceFlow id="f12" sourceRef="c_contract_decision" targetRef="c_return_contract" name="Доработка договора">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Не согласен с условиями</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" sourceRef="c_contract_decision" targetRef="c_sign_contract" name="Подписание договора">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Согласен с условиями</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" sourceRef="c_return_contract" targetRef="c_receive_modified_contract" name=""/>
    <bpmn:sequenceFlow id="f15" sourceRef="c_receive_modified_contract" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="f16" sourceRef="c_sign_contract" targetRef="c_send_signed" name=""/>
    <bpmn:sequenceFlow id="f17" sourceRef="c_send_signed" targetRef="c_end_signed" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_c_wait" sourceRef="Merge_c_wait" targetRef="c_wait" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_organization_pool" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_docs_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_return_rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait_corrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_refusal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal" name="Юридический отдел">
        <bpmn:flowNodeRef>o_legal_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security" name="Служба безопасности">
        <bpmn:flowNodeRef>o_security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="leader" name="Руководитель">
        <bpmn:flowNodeRef>o_decision_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Менеджер">
        <bpmn:flowNodeRef>o_form_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait_contract_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_receive_returned_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_receive_signed_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_modify_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_resend_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_register_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_o_wait_contract_response</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="o_start" name="Получить заявку">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_o_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="o_check_docs" name="Проверить документы">
      <bpmn:documentation>проверяет документы.</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_docs_decision" name="Документы корректны?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если документов не хватает или они заполнены неправильно,... Если документы корректны,", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_return_rework" name="Вернуть заявку клиенту на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_wait_corrected" name="Получить исправленные документы">
      <bpmn:documentation>повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="o_parallel_split" name="Начать одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_legal_check" name="Проверить заявку">
      <bpmn:documentation>юридический отдел ... проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="o_security_check" name="Проверить заявку">
      <bpmn:documentation>служба безопасности ... проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="o_parallel_join" name="Завершить одновременные проверки" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_decision_task" name="Принять решение по заявке">
      <bpmn:documentation>руководитель принимает решение.</bpmn:documentation>
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_decision" name="Решение по заявке" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "руководитель принимает решение.", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_send_refusal" name="Отправить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="o_end_refusal" name="Процесс завершён после отказа">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="o_form_contract" name="Сформировать договор">
      <bpmn:documentation>менеджер формирует договор</bpmn:documentation>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>и отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="o_wait_contract_response" name="Ожидать ответ клиента" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_o_wait_contract_response</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="o_receive_returned_contract" name="Получить договор на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="o_receive_signed_contract" name="Получить подписанный договор">
      <bpmn:documentation>отправляет его менеджеру.</bpmn:documentation>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f40</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_modify_contract" name="Внести изменения в договор">
      <bpmn:documentation>Менеджер вносит изменения</bpmn:documentation>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_resend_contract" name="Повторно отправить договор клиенту">
      <bpmn:documentation>повторно отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:outgoing>f39</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="o_register_contract" name="Зарегистрировать подписанный договор">
      <bpmn:documentation>Менеджер регистрирует подписанный договор</bpmn:documentation>
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:outgoing>f41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="o_end_success" name="Процесс завершён">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_o_wait_contract_response" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_o_wait_contract_response</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f18" sourceRef="o_start" targetRef="o_check_docs" name=""/>
    <bpmn:sequenceFlow id="f19" sourceRef="o_check_docs" targetRef="o_docs_decision" name=""/>
    <bpmn:sequenceFlow id="f20" sourceRef="o_docs_decision" targetRef="o_return_rework" name="Доработка документов">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы неполные или заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f21" sourceRef="o_docs_decision" targetRef="o_parallel_split" name="Проверки">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f22" sourceRef="o_return_rework" targetRef="o_wait_corrected" name=""/>
    <bpmn:sequenceFlow id="f23" sourceRef="o_wait_corrected" targetRef="o_check_docs" name=""/>
    <bpmn:sequenceFlow id="f24" sourceRef="o_parallel_split" targetRef="o_legal_check" name=""/>
    <bpmn:sequenceFlow id="f25" sourceRef="o_parallel_split" targetRef="o_security_check" name=""/>
    <bpmn:sequenceFlow id="f26" sourceRef="o_legal_check" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f27" sourceRef="o_security_check" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f28" sourceRef="o_parallel_join" targetRef="o_decision_task" name=""/>
    <bpmn:sequenceFlow id="f29" sourceRef="o_decision_task" targetRef="o_decision" name=""/>
    <bpmn:sequenceFlow id="f30" sourceRef="o_decision" targetRef="o_send_refusal" name="Отказ">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f31" sourceRef="o_decision" targetRef="o_form_contract" name="Одобрение">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f32" sourceRef="o_send_refusal" targetRef="o_end_refusal" name=""/>
    <bpmn:sequenceFlow id="f33" sourceRef="o_form_contract" targetRef="o_send_contract" name=""/>
    <bpmn:sequenceFlow id="f34" sourceRef="o_send_contract" targetRef="Merge_o_wait_contract_response" name=""/>
    <bpmn:sequenceFlow id="f35" sourceRef="o_wait_contract_response" targetRef="o_receive_returned_contract" name=""/>
    <bpmn:sequenceFlow id="f36" sourceRef="o_wait_contract_response" targetRef="o_receive_signed_contract" name=""/>
    <bpmn:sequenceFlow id="f37" sourceRef="o_receive_returned_contract" targetRef="o_modify_contract" name=""/>
    <bpmn:sequenceFlow id="f38" sourceRef="o_modify_contract" targetRef="o_resend_contract" name=""/>
    <bpmn:sequenceFlow id="f39" sourceRef="o_resend_contract" targetRef="Merge_o_wait_contract_response" name=""/>
    <bpmn:sequenceFlow id="f40" sourceRef="o_receive_signed_contract" targetRef="o_register_contract" name=""/>
    <bpmn:sequenceFlow id="f41" sourceRef="o_register_contract" targetRef="o_end_success" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_o_wait_contract_response" sourceRef="Merge_o_wait_contract_response" targetRef="o_wait_contract_response" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="process_connection" name="Подключение объекта">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта.
Оператор получает заявку и проверяет документы.
Если документов не хватает или они заполнены неправильно,
оператор возвращает заявку клиенту на доработку.
Клиент исправляет документы и повторно отправляет их оператору.

Если документы корректны,
юридический отдел и служба безопасности одновременно проверяют заявку.
После завершения обеих проверок руководитель принимает решение.

Если заявка отклонена,
оператор отправляет клиенту уведомление об отказе,
после чего процесс завершается.

Если заявка одобрена,
менеджер формирует договор и отправляет его клиенту.

Клиент проверяет договор.
Если клиент не согласен с условиями,
он возвращает договор менеджеру на доработку.
Менеджер вносит изменения и повторно отправляет договор клиенту.

Если клиент согласен,
он подписывает договор и отправляет его менеджеру.
Менеджер регистрирует подписанный договор,
после чего процесс завершается.</bpmn:documentation>
    <bpmn:participant id="client_pool" name="Клиент" processRef="Process_client_pool">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "client_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="organization_pool" name="Организация" processRef="Process_organization_pool">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "legal", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "security", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "leader", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "organization_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf01" sourceRef="c_submit" targetRef="o_start" name="Заявка"/>
    <bpmn:messageFlow id="mf02" sourceRef="o_return_rework" targetRef="c_receive_rework" name="Запрос на доработку"/>
    <bpmn:messageFlow id="mf03" sourceRef="c_resend_docs" targetRef="o_wait_corrected" name="Исправленные документы"/>
    <bpmn:messageFlow id="mf04" sourceRef="o_send_refusal" targetRef="c_receive_refusal" name="Уведомление об отказе"/>
    <bpmn:messageFlow id="mf05" sourceRef="o_send_contract" targetRef="c_receive_contract" name="Договор"/>
    <bpmn:messageFlow id="mf06" sourceRef="c_return_contract" targetRef="o_receive_returned_contract" name="Договор на доработку"/>
    <bpmn:messageFlow id="mf07" sourceRef="o_resend_contract" targetRef="c_receive_modified_contract" name="Договор с изменениями"/>
    <bpmn:messageFlow id="mf08" sourceRef="c_send_signed" targetRef="o_receive_signed_contract" name="Подписанный договор"/>
  </bpmn:collaboration>
