<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_pool_client" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Начать подачу заявки">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_submit" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_wait" name="Ожидать результат проверки" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_reject" name="Получить уведомление об отказе">
      <bpmn:documentation>PULSE_NODE:{"source_text": "оператор отправляет клиенту уведомление об отказе", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_c_reject"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_contract" name="Получить договор">
      <bpmn:documentation>PULSE_NODE:{"source_text": "менеджер формирует договор и отправляет его клиенту", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_c_contract"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="c_check" name="Проверить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="c_decision" name="Принять решение по договору" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если клиент не согласен", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="c_return" name="Вернуть договор на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="c_revised" name="Получить исправленный договор">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Менеджер изменяет договор и повторно отправляет клиенту.", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_c_revised"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="c_sign" name="Подписать договор и отправить менеджеру">
      <bpmn:documentation>он подписывает договор и отправляет менеджеру</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="c_end" name="Завершить процесс клиента">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="c_start" targetRef="c_submit" name=""/>
    <bpmn:sequenceFlow id="f2" sourceRef="c_submit" targetRef="c_wait" name=""/>
    <bpmn:sequenceFlow id="f3" sourceRef="c_wait" targetRef="c_reject" name=""/>
    <bpmn:sequenceFlow id="f4" sourceRef="c_wait" targetRef="c_contract" name=""/>
    <bpmn:sequenceFlow id="f5" sourceRef="c_reject" targetRef="c_end" name=""/>
    <bpmn:sequenceFlow id="f6" sourceRef="c_contract" targetRef="c_check" name=""/>
    <bpmn:sequenceFlow id="f7" sourceRef="c_check" targetRef="c_decision" name=""/>
    <bpmn:sequenceFlow id="f8" sourceRef="c_decision" targetRef="c_return" name="Не согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент не согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" sourceRef="c_decision" targetRef="c_sign" name="Согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="c_return" targetRef="c_revised" name=""/>
    <bpmn:sequenceFlow id="f11" sourceRef="c_revised" targetRef="c_check" name=""/>
    <bpmn:sequenceFlow id="f12" sourceRef="c_sign" targetRef="c_end" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_pool_org" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>op_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>op_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal" name="Юридический отдел">
        <bpmn:flowNodeRef>legal_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security" name="Служба безопасности">
        <bpmn:flowNodeRef>security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="leader" name="Руководитель">
        <bpmn:flowNodeRef>leader_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leader_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Менеджер">
        <bpmn:flowNodeRef>manager_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_manager_wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="op_start" name="Получить заявку">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Оператор получает заявку", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_op_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="op_check" name="Проверить документы">
      <bpmn:documentation>проверяет документы</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="op_decision" name="Оценить корректность документов" gatewayDirection="Mixed">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если документов не хватает или они заполнены неправильно", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="op_return" name="Вернуть заявку на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку</bpmn:documentation>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="op_wait" name="Получить исправленные документы">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Клиент исправляет документы и повторно отправляет их оператору.", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_op_wait"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="op_split" name="Запустить одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="legal_check" name="Проверить заявку">
      <bpmn:documentation>юридический отдел ... проверяют заявку</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="security_check" name="Проверить заявку">
      <bpmn:documentation>служба безопасности одновременно проверяют заявку</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="op_join" name="Завершить обе проверки" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок</bpmn:documentation>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="leader_decision" name="Принять решение по заявке">
      <bpmn:documentation>руководитель принимает решение</bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
      <bpmn:outgoing>f38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="leader_gateway" name="Определить исход заявки" gatewayDirection="Mixed">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если заявка отклонена ... Если заявка одобрена", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="op_notify" name="Отправить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="manager_form" name="Сформировать договор">
      <bpmn:documentation>менеджер формирует договор</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="manager_send" name="Отправить договор клиенту">
      <bpmn:documentation>и отправляет его клиенту</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="manager_wait" name="Ожидать ответ клиента" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Клиент проверяет договор.", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_manager_wait</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="manager_return" name="Получить договор на доработку">
      <bpmn:documentation>PULSE_NODE:{"source_text": "он возвращает договор менеджеру на доработку", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_manager_return"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="manager_signed" name="Получить подписанный договор">
      <bpmn:documentation>PULSE_NODE:{"source_text": "отправляет менеджеру", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_manager_signed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="manager_change" name="Изменить договор">
      <bpmn:documentation>Менеджер изменяет договор</bpmn:documentation>
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="manager_resend" name="Повторно отправить договор клиенту">
      <bpmn:documentation>и повторно отправляет клиенту</bpmn:documentation>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="manager_register" name="Зарегистрировать договор">
      <bpmn:documentation>Менеджер регистрирует договор</bpmn:documentation>
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="op_end" name="Завершить процесс организации">
      <bpmn:documentation>после чего процесс завершается</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:incoming>f34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_manager_wait" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_manager_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f13" sourceRef="op_start" targetRef="op_check" name=""/>
    <bpmn:sequenceFlow id="f14" sourceRef="op_decision" targetRef="op_return" name="">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы неполные или заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f15" sourceRef="op_decision" targetRef="op_split" name="">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f16" sourceRef="op_return" targetRef="op_wait" name=""/>
    <bpmn:sequenceFlow id="f17" sourceRef="op_wait" targetRef="op_check" name=""/>
    <bpmn:sequenceFlow id="f18" sourceRef="op_split" targetRef="legal_check" name=""/>
    <bpmn:sequenceFlow id="f19" sourceRef="op_split" targetRef="security_check" name=""/>
    <bpmn:sequenceFlow id="f20" sourceRef="legal_check" targetRef="op_join" name=""/>
    <bpmn:sequenceFlow id="f21" sourceRef="security_check" targetRef="op_join" name=""/>
    <bpmn:sequenceFlow id="f22" sourceRef="op_join" targetRef="leader_decision" name=""/>
    <bpmn:sequenceFlow id="f23" sourceRef="leader_gateway" targetRef="op_notify" name="">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f24" sourceRef="leader_gateway" targetRef="manager_form" name="">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f25" sourceRef="op_notify" targetRef="op_end" name=""/>
    <bpmn:sequenceFlow id="f26" sourceRef="manager_form" targetRef="manager_send" name=""/>
    <bpmn:sequenceFlow id="f27" sourceRef="manager_send" targetRef="Merge_manager_wait" name=""/>
    <bpmn:sequenceFlow id="f28" sourceRef="manager_wait" targetRef="manager_return" name=""/>
    <bpmn:sequenceFlow id="f29" sourceRef="manager_wait" targetRef="manager_signed" name=""/>
    <bpmn:sequenceFlow id="f30" sourceRef="manager_return" targetRef="manager_change" name=""/>
    <bpmn:sequenceFlow id="f31" sourceRef="manager_change" targetRef="manager_resend" name=""/>
    <bpmn:sequenceFlow id="f32" sourceRef="manager_resend" targetRef="Merge_manager_wait" name=""/>
    <bpmn:sequenceFlow id="f33" sourceRef="manager_signed" targetRef="manager_register" name=""/>
    <bpmn:sequenceFlow id="f34" sourceRef="manager_register" targetRef="op_end" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_manager_wait" sourceRef="Merge_manager_wait" targetRef="manager_wait" name=""/>
    <bpmn:sequenceFlow id="f35" sourceRef="op_check" targetRef="op_decision" name="Нужна доработка">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы неполные или заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f36" sourceRef="op_check" targetRef="op_decision" name="Документы корректны">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f37" sourceRef="leader_decision" targetRef="leader_gateway" name="Отклонена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f38" sourceRef="leader_decision" targetRef="leader_gateway" name="Одобрена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:collaboration id="process_connection_application" name="Подключение объекта">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта.
Оператор получает заявку и проверяет документы.
Если документов не хватает или они заполнены неправильно,
оператор возвращает заявку клиенту на доработку.
Клиент исправляет документы и повторно отправляет их оператору.

Если документы корректны,
юридический отдел и служба безопасности одновременно проверяют заявку.
После завершения обеих проверок руководитель принимает решение.

Если заявка отклонена,
оператор отправляет клиенту уведомление об отказе,
после чего процесс завершается.

Если заявка одобрена,
менеджер формирует договор и отправляет его клиенту.

Клиент проверяет договор.
Если клиент не согласен,
он возвращает договор менеджеру на доработку.
Менеджер изменяет договор и повторно отправляет клиенту.

Если клиент согласен,
он подписывает договор и отправляет менеджеру.
Менеджер регистрирует договор,
после чего процесс завершается.</bpmn:documentation>
    <bpmn:documentation>PULSE_ASSUMPTIONS:[{"id": "a1", "text": "Оператор, юридический отдел, служба безопасности, руководитель и менеджер являются внутренними ролями одной организации.", "source": "model_inference", "confidence": 0.98}]</bpmn:documentation>
    <bpmn:participant id="pool_client" name="Клиент" processRef="Process_pool_client">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "pool_client"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="pool_org" name="Организация" processRef="Process_pool_org">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "legal", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "security", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "leader", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "pool_org"}]}</bpmn:documentation>
    </bpmn:participant>
