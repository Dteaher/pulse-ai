<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_pool_client" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_submit" name="Подать заявку на подключение объекта">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="c_merge" name="Объединение отправок заявки" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:incoming>f09</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="c_wait" name="Какой ответ получен?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
      <bpmn:outgoing>f05</bpmn:outgoing>
      <bpmn:outgoing>f06</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="c_request" name="Получить заявку на доработку">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_correct" name="Исправить документы">
      <bpmn:documentation>Клиент исправляет документы и повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_resubmit" name="Повторно отправить документы оператору">
      <bpmn:documentation>Клиент исправляет документы и повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_refusal" name="Получить уведомление об отказе">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="c_end_refusal" name="Получен отказ">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="c_contract" name="Получить договор">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_check" name="Проверить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="c_agree" name="Клиент согласен с условиями?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если клиент не согласен с условиями,\nон возвращает договор менеджеру на доработку.", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="c_return" name="Вернуть договор менеджеру на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_revised" name="Получить изменённый договор">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_sign" name="Подписать договор">
      <bpmn:documentation>он подписывает договор и отправляет его менеджеру.</bpmn:documentation>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_send_signed" name="Отправить подписанный договор менеджеру">
      <bpmn:documentation>он подписывает договор и отправляет его менеджеру.</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="c_end_signed" name="Подписанный договор отправлен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f01" sourceRef="c_start" targetRef="c_submit" name=""/>
    <bpmn:sequenceFlow id="f02" sourceRef="c_submit" targetRef="c_merge" name=""/>
    <bpmn:sequenceFlow id="f03" sourceRef="c_merge" targetRef="c_wait" name=""/>
    <bpmn:sequenceFlow id="f04" sourceRef="c_wait" targetRef="c_request" name=""/>
    <bpmn:sequenceFlow id="f05" sourceRef="c_wait" targetRef="c_refusal" name=""/>
    <bpmn:sequenceFlow id="f06" sourceRef="c_wait" targetRef="c_contract" name=""/>
    <bpmn:sequenceFlow id="f07" sourceRef="c_request" targetRef="c_correct" name=""/>
    <bpmn:sequenceFlow id="f08" sourceRef="c_correct" targetRef="c_resubmit" name=""/>
    <bpmn:sequenceFlow id="f09" sourceRef="c_resubmit" targetRef="c_merge" name=""/>
    <bpmn:sequenceFlow id="f10" sourceRef="c_refusal" targetRef="c_end_refusal" name=""/>
    <bpmn:sequenceFlow id="f11" sourceRef="c_contract" targetRef="c_check" name=""/>
    <bpmn:sequenceFlow id="f12" sourceRef="c_check" targetRef="c_agree" name=""/>
    <bpmn:sequenceFlow id="f13" sourceRef="c_agree" targetRef="c_return" name="Не согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент не согласен с условиями</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" sourceRef="c_agree" targetRef="c_sign" name="Согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент согласен с условиями</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f15" sourceRef="c_return" targetRef="c_revised" name=""/>
    <bpmn:sequenceFlow id="f16" sourceRef="c_revised" targetRef="c_check" name=""/>
    <bpmn:sequenceFlow id="f17" sourceRef="c_sign" targetRef="c_send_signed" name=""/>
    <bpmn:sequenceFlow id="f18" sourceRef="c_send_signed" targetRef="c_end_signed" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_pool_org" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_receive_corrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_refusal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal" name="Юридический отдел">
        <bpmn:flowNodeRef>o_legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security" name="Служба безопасности">
        <bpmn:flowNodeRef>o_security</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Руководитель">
        <bpmn:flowNodeRef>o_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_outcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Менеджер">
        <bpmn:flowNodeRef>o_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_receive_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_modify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_receive_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_registered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="o_start" name="Получена заявка">
      <bpmn:documentation>Оператор получает заявку и проверяет документы.</bpmn:documentation>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_o_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="o_check" name="Проверить документы">
      <bpmn:documentation>Оператор получает заявку и проверяет документы.</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_valid" name="Документы полные и корректные?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если документов не хватает или они заполнены неправильно,\nоператор возвращает заявку клиенту на доработку.", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_return" name="Вернуть заявку клиенту на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_receive_corrected" name="Получить исправленные документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="o_split" name="Начать одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_legal" name="Проверить заявку">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="o_security" name="Проверить заявку">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="o_join" name="Обе проверки завершены" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок руководитель принимает решение.</bpmn:documentation>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_decide" name="Принять решение по заявке">
      <bpmn:documentation>После завершения обеих проверок руководитель принимает решение.</bpmn:documentation>
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_outcome" name="Заявка одобрена?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если заявка одобрена,\nменеджер формирует договор и отправляет его клиенту.", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_refuse" name="Отправить клиенту уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе,</bpmn:documentation>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="o_end_refusal" name="Заявка отклонена">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="o_form" name="Сформировать договор">
      <bpmn:documentation>менеджер формирует договор и отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_send" name="Отправить договор клиенту">
      <bpmn:documentation>менеджер формирует договор и отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="o_merge" name="Объединение отправок договора" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:incoming>f41</bpmn:incoming>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="o_wait" name="Какой договор получен от клиента?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
      <bpmn:outgoing>f38</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="o_receive_return" name="Получить договор на доработку">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f39</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_modify" name="Внести изменения в договор">
      <bpmn:documentation>Менеджер вносит изменения и повторно отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:outgoing>f40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_resend" name="Повторно отправить договор клиенту">
      <bpmn:documentation>Менеджер вносит изменения и повторно отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:outgoing>f41</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_receive_signed" name="Получить подписанный договор">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:outgoing>f42</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_register" name="Зарегистрировать подписанный договор">
      <bpmn:documentation>Менеджер регистрирует подписанный договор,</bpmn:documentation>
      <bpmn:incoming>f42</bpmn:incoming>
      <bpmn:outgoing>f43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="o_end_registered" name="Договор зарегистрирован">
      <bpmn:documentation>Менеджер регистрирует подписанный договор,
после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>f43</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f19" sourceRef="o_start" targetRef="o_check" name=""/>
    <bpmn:sequenceFlow id="f20" sourceRef="o_check" targetRef="o_valid" name=""/>
    <bpmn:sequenceFlow id="f21" sourceRef="o_valid" targetRef="o_return" name="Документы неполные или некорректные">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документов не хватает или они заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f22" sourceRef="o_return" targetRef="o_receive_corrected" name=""/>
    <bpmn:sequenceFlow id="f23" sourceRef="o_receive_corrected" targetRef="o_check" name=""/>
    <bpmn:sequenceFlow id="f24" sourceRef="o_valid" targetRef="o_split" name="Документы корректны">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f25" sourceRef="o_split" targetRef="o_legal" name=""/>
    <bpmn:sequenceFlow id="f26" sourceRef="o_split" targetRef="o_security" name=""/>
    <bpmn:sequenceFlow id="f27" sourceRef="o_legal" targetRef="o_join" name=""/>
    <bpmn:sequenceFlow id="f28" sourceRef="o_security" targetRef="o_join" name=""/>
    <bpmn:sequenceFlow id="f29" sourceRef="o_join" targetRef="o_decide" name=""/>
    <bpmn:sequenceFlow id="f30" sourceRef="o_decide" targetRef="o_outcome" name=""/>
    <bpmn:sequenceFlow id="f31" sourceRef="o_outcome" targetRef="o_refuse" name="Отклонена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f32" sourceRef="o_refuse" targetRef="o_end_refusal" name=""/>
    <bpmn:sequenceFlow id="f33" sourceRef="o_outcome" targetRef="o_form" name="Одобрена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f34" sourceRef="o_form" targetRef="o_send" name=""/>
    <bpmn:sequenceFlow id="f35" sourceRef="o_send" targetRef="o_merge" name=""/>
    <bpmn:sequenceFlow id="f36" sourceRef="o_merge" targetRef="o_wait" name=""/>
    <bpmn:sequenceFlow id="f37" sourceRef="o_wait" targetRef="o_receive_return" name=""/>
    <bpmn:sequenceFlow id="f38" sourceRef="o_wait" targetRef="o_receive_signed" name=""/>
    <bpmn:sequenceFlow id="f39" sourceRef="o_receive_return" targetRef="o_modify" name=""/>
    <bpmn:sequenceFlow id="f40" sourceRef="o_modify" targetRef="o_resend" name=""/>
    <bpmn:sequenceFlow id="f41" sourceRef="o_resend" targetRef="o_merge" name=""/>
    <bpmn:sequenceFlow id="f42" sourceRef="o_receive_signed" targetRef="o_register" name=""/>
    <bpmn:sequenceFlow id="f43" sourceRef="o_register" targetRef="o_end_registered" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="connection_process" name="Подключение объекта и заключение договора">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта.
Оператор получает заявку и проверяет документы.
Если документов не хватает или они заполнены неправильно,
оператор возвращает заявку клиенту на доработку.
Клиент исправляет документы и повторно отправляет их оператору.

Если документы корректны,
юридический отдел и служба безопасности одновременно проверяют заявку.
После завершения обеих проверок руководитель принимает решение.

Если заявка отклонена,
оператор отправляет клиенту уведомление об отказе,
после чего процесс завершается.

Если заявка одобрена,
менеджер формирует договор и отправляет его клиенту.

Клиент проверяет договор.
Если клиент не согласен с условиями,
он возвращает договор менеджеру на доработку.
Менеджер вносит изменения и повторно отправляет договор клиенту.

Если клиент согласен,
он подписывает договор и отправляет его менеджеру.
Менеджер регистрирует подписанный договор,
после чего процесс завершается.
</bpmn:documentation>
    <bpmn:participant id="pool_client" name="Клиент" processRef="Process_pool_client">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "pool_client"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="pool_org" name="Организация" processRef="Process_pool_org">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "legal", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "security", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "head", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "pool_org"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="m01" sourceRef="c_submit" targetRef="o_start" name="Заявка на подключение объекта"/>
    <bpmn:messageFlow id="m02" sourceRef="o_return" targetRef="c_request" name="Заявка на доработку"/>
    <bpmn:messageFlow id="m03" sourceRef="c_resubmit" targetRef="o_receive_corrected" name="Исправленные документы"/>
    <bpmn:messageFlow id="m04" sourceRef="o_refuse" targetRef="c_refusal" name="Уведомление об отказе"/>
    <bpmn:messageFlow id="m05" sourceRef="o_send" targetRef="c_contract" name="Договор"/>
    <bpmn:messageFlow id="m06" sourceRef="c_return" targetRef="o_receive_return" name="Договор на доработку"/>
    <bpmn:messageFlow id="m07" sourceRef="o_resend" targetRef="c_revised" name="Изменённый договор"/>
    <bpmn:messageFlow id="m08" sourceRef="c_send_signed" targetRef="o_receive_signed" name="Подписанный договор"/>
  </bpmn:collaboration>
