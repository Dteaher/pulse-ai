<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_pool_client" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Начало процесса">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:outgoing>f_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_submit" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:incoming>f_c1</bpmn:incoming>
      <bpmn:outgoing>f_c2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_wait" name="Ожидать сообщение от оператора" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_c_wait</bpmn:incoming>
      <bpmn:outgoing>f_c3</bpmn:outgoing>
      <bpmn:outgoing>f_c7</bpmn:outgoing>
      <bpmn:outgoing>f_c9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="c_get_correction" name="Получить заявку на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку</bpmn:documentation>
      <bpmn:incoming>f_c3</bpmn:incoming>
      <bpmn:outgoing>f_c4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_fix_docs" name="Исправить документы">
      <bpmn:documentation>Клиент исправляет документы</bpmn:documentation>
      <bpmn:incoming>f_c4</bpmn:incoming>
      <bpmn:outgoing>f_c5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_resend_docs" name="Повторно отправить документы оператору">
      <bpmn:documentation>повторно отправляет их оператору</bpmn:documentation>
      <bpmn:incoming>f_c5</bpmn:incoming>
      <bpmn:outgoing>f_c6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_get_refusal" name="Получить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>f_c7</bpmn:incoming>
      <bpmn:outgoing>f_c8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="c_end_refusal" name="Процесс завершён после отказа">
      <bpmn:documentation>после чего процесс завершается</bpmn:documentation>
      <bpmn:incoming>f_c8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="c_get_contract" name="Получить договор">
      <bpmn:documentation>отправляет его клиенту</bpmn:documentation>
      <bpmn:incoming>f_c9</bpmn:incoming>
      <bpmn:outgoing>f_c10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_check_contract" name="Проверить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>f_c10</bpmn:incoming>
      <bpmn:incoming>f_c16</bpmn:incoming>
      <bpmn:outgoing>f_c11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="c_contract_decision" name="Договор согласован?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если клиент не согласен", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_c11</bpmn:incoming>
      <bpmn:outgoing>f_c12</bpmn:outgoing>
      <bpmn:outgoing>f_c13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="c_return_contract" name="Вернуть договор менеджеру на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку</bpmn:documentation>
      <bpmn:incoming>f_c12</bpmn:incoming>
      <bpmn:outgoing>f_c14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_wait_revision" name="Ожидать изменённый договор">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f_c14</bpmn:incoming>
      <bpmn:outgoing>f_c15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="c_get_revision" name="Получить изменённый договор">
      <bpmn:documentation>Менеджер изменяет договор и повторно отправляет клиенту.</bpmn:documentation>
      <bpmn:incoming>f_c15</bpmn:incoming>
      <bpmn:outgoing>f_c16</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_sign_contract" name="Подписать договор">
      <bpmn:documentation>он подписывает договор</bpmn:documentation>
      <bpmn:incoming>f_c13</bpmn:incoming>
      <bpmn:outgoing>f_c17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_send_signed" name="Отправить подписанный договор менеджеру">
      <bpmn:documentation>отправляет менеджеру</bpmn:documentation>
      <bpmn:incoming>f_c17</bpmn:incoming>
      <bpmn:outgoing>f_c18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="c_end_signed" name="Процесс завершён">
      <bpmn:documentation>после чего процесс завершается</bpmn:documentation>
      <bpmn:incoming>f_c18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_c_wait" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_c2</bpmn:incoming>
      <bpmn:incoming>f_c6</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_c_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f_c1" sourceRef="c_start" targetRef="c_submit" name=""/>
    <bpmn:sequenceFlow id="f_c2" sourceRef="c_submit" targetRef="Merge_c_wait" name=""/>
    <bpmn:sequenceFlow id="f_c3" sourceRef="c_wait" targetRef="c_get_correction" name=""/>
    <bpmn:sequenceFlow id="f_c4" sourceRef="c_get_correction" targetRef="c_fix_docs" name=""/>
    <bpmn:sequenceFlow id="f_c5" sourceRef="c_fix_docs" targetRef="c_resend_docs" name=""/>
    <bpmn:sequenceFlow id="f_c6" sourceRef="c_resend_docs" targetRef="Merge_c_wait" name=""/>
    <bpmn:sequenceFlow id="f_c7" sourceRef="c_wait" targetRef="c_get_refusal" name=""/>
    <bpmn:sequenceFlow id="f_c8" sourceRef="c_get_refusal" targetRef="c_end_refusal" name=""/>
    <bpmn:sequenceFlow id="f_c9" sourceRef="c_wait" targetRef="c_get_contract" name=""/>
    <bpmn:sequenceFlow id="f_c10" sourceRef="c_get_contract" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="f_c11" sourceRef="c_check_contract" targetRef="c_contract_decision" name=""/>
    <bpmn:sequenceFlow id="f_c12" sourceRef="c_contract_decision" targetRef="c_return_contract" name="Не согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент не согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_c13" sourceRef="c_contract_decision" targetRef="c_sign_contract" name="Согласен">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_c14" sourceRef="c_return_contract" targetRef="c_wait_revision" name=""/>
    <bpmn:sequenceFlow id="f_c15" sourceRef="c_wait_revision" targetRef="c_get_revision" name=""/>
    <bpmn:sequenceFlow id="f_c16" sourceRef="c_get_revision" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="f_c17" sourceRef="c_sign_contract" targetRef="c_send_signed" name=""/>
    <bpmn:sequenceFlow id="f_c18" sourceRef="c_send_signed" targetRef="c_end_signed" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_c_wait" sourceRef="Merge_c_wait" targetRef="c_wait" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_pool_organization" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_docs_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_return_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_refusal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal" name="Юридический отдел">
        <bpmn:flowNodeRef>o_legal_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security" name="Служба безопасности">
        <bpmn:flowNodeRef>o_security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Руководитель и менеджер">
        <bpmn:flowNodeRef>o_manager_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_result_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_form_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_change_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_resend_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_register_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_o_wait_contract</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="o_start" name="Получить заявку">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:outgoing>f_o1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_o_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="o_check_docs" name="Проверить документы">
      <bpmn:documentation>проверяет документы</bpmn:documentation>
      <bpmn:incoming>f_o1</bpmn:incoming>
      <bpmn:incoming>f_o7</bpmn:incoming>
      <bpmn:outgoing>f_o2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_docs_gateway" name="Документы полные и корректные?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если документов не хватает или они заполнены неправильно", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o2</bpmn:incoming>
      <bpmn:outgoing>f_o3</bpmn:outgoing>
      <bpmn:outgoing>f_o4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_return_docs" name="Вернуть заявку клиенту на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку</bpmn:documentation>
      <bpmn:incoming>f_o3</bpmn:incoming>
      <bpmn:outgoing>f_o5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_wait_docs" name="Ожидать исправленные документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f_o5</bpmn:incoming>
      <bpmn:outgoing>f_o6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="o_get_docs" name="Получить исправленные документы">
      <bpmn:documentation>повторно отправляет их оператору</bpmn:documentation>
      <bpmn:incoming>f_o6</bpmn:incoming>
      <bpmn:outgoing>f_o7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="o_parallel_split" name="Начать одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку</bpmn:documentation>
      <bpmn:incoming>f_o4</bpmn:incoming>
      <bpmn:outgoing>f_o8</bpmn:outgoing>
      <bpmn:outgoing>f_o9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_legal_check" name="Проверить заявку">
      <bpmn:documentation>юридический отдел ... проверяют заявку</bpmn:documentation>
      <bpmn:incoming>f_o8</bpmn:incoming>
      <bpmn:outgoing>f_o10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="o_security_check" name="Проверить заявку">
      <bpmn:documentation>служба безопасности ... проверяют заявку</bpmn:documentation>
      <bpmn:incoming>f_o9</bpmn:incoming>
      <bpmn:outgoing>f_o11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="o_parallel_join" name="Завершить одновременные проверки" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок</bpmn:documentation>
      <bpmn:incoming>f_o10</bpmn:incoming>
      <bpmn:incoming>f_o11</bpmn:incoming>
      <bpmn:outgoing>f_o12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_manager_decision" name="Принять решение по заявке">
      <bpmn:documentation>руководитель принимает решение</bpmn:documentation>
      <bpmn:incoming>f_o12</bpmn:incoming>
      <bpmn:outgoing>f_o13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="o_result_gateway" name="Заявка одобрена?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если заявка отклонена; Если заявка одобрена", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o13</bpmn:incoming>
      <bpmn:outgoing>f_o14</bpmn:outgoing>
      <bpmn:outgoing>f_o15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="o_send_refusal" name="Отправить уведомление об отказе клиенту">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>f_o14</bpmn:incoming>
      <bpmn:outgoing>f_o16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="o_end_refusal" name="Процесс завершён после отказа">
      <bpmn:documentation>после чего процесс завершается</bpmn:documentation>
      <bpmn:incoming>f_o16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="o_form_contract" name="Сформировать договор">
      <bpmn:documentation>менеджер формирует договор</bpmn:documentation>
      <bpmn:incoming>f_o15</bpmn:incoming>
      <bpmn:outgoing>f_o17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>отправляет его клиенту</bpmn:documentation>
      <bpmn:incoming>f_o17</bpmn:incoming>
      <bpmn:outgoing>f_o18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="o_wait_contract" name="Ожидать сообщение от клиента" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_o_wait_contract</bpmn:incoming>
      <bpmn:outgoing>f_o19</bpmn:outgoing>
      <bpmn:outgoing>f_o23</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="o_get_revision" name="Получить договор на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку</bpmn:documentation>
      <bpmn:incoming>f_o19</bpmn:incoming>
      <bpmn:outgoing>f_o20</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_change_contract" name="Изменить договор">
      <bpmn:documentation>Менеджер изменяет договор</bpmn:documentation>
      <bpmn:incoming>f_o20</bpmn:incoming>
      <bpmn:outgoing>f_o21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_resend_contract" name="Повторно отправить договор клиенту">
      <bpmn:documentation>повторно отправляет клиенту</bpmn:documentation>
      <bpmn:incoming>f_o21</bpmn:incoming>
      <bpmn:outgoing>f_o22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_get_signed" name="Получить подписанный договор">
      <bpmn:documentation>отправляет менеджеру</bpmn:documentation>
      <bpmn:incoming>f_o23</bpmn:incoming>
      <bpmn:outgoing>f_o24</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_register_contract" name="Зарегистрировать договор">
      <bpmn:documentation>Менеджер регистрирует договор</bpmn:documentation>
      <bpmn:incoming>f_o24</bpmn:incoming>
      <bpmn:outgoing>f_o25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="o_end_registered" name="Процесс завершён">
      <bpmn:documentation>после чего процесс завершается</bpmn:documentation>
      <bpmn:incoming>f_o25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_o_wait_contract" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_o18</bpmn:incoming>
      <bpmn:incoming>f_o22</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_o_wait_contract</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f_o1" sourceRef="o_start" targetRef="o_check_docs" name=""/>
    <bpmn:sequenceFlow id="f_o2" sourceRef="o_check_docs" targetRef="o_docs_gateway" name=""/>
    <bpmn:sequenceFlow id="f_o3" sourceRef="o_docs_gateway" targetRef="o_return_docs" name="Документы требуют доработки">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документов не хватает или они заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o4" sourceRef="o_docs_gateway" targetRef="o_parallel_split" name="Документы корректны">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o5" sourceRef="o_return_docs" targetRef="o_wait_docs" name=""/>
    <bpmn:sequenceFlow id="f_o6" sourceRef="o_wait_docs" targetRef="o_get_docs" name=""/>
    <bpmn:sequenceFlow id="f_o7" sourceRef="o_get_docs" targetRef="o_check_docs" name=""/>
    <bpmn:sequenceFlow id="f_o8" sourceRef="o_parallel_split" targetRef="o_legal_check" name=""/>
    <bpmn:sequenceFlow id="f_o9" sourceRef="o_parallel_split" targetRef="o_security_check" name=""/>
    <bpmn:sequenceFlow id="f_o10" sourceRef="o_legal_check" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f_o11" sourceRef="o_security_check" targetRef="o_parallel_join" name=""/>
    <bpmn:sequenceFlow id="f_o12" sourceRef="o_parallel_join" targetRef="o_manager_decision" name=""/>
    <bpmn:sequenceFlow id="f_o13" sourceRef="o_manager_decision" targetRef="o_result_gateway" name=""/>
    <bpmn:sequenceFlow id="f_o14" sourceRef="o_result_gateway" targetRef="o_send_refusal" name="Отклонена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_o15" sourceRef="o_result_gateway" targetRef="o_form_contract" name="Одобрена">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
