# PRIMARY — MULTIAI
PRIMARY_LLM_PROVIDER=multiai
PRIMARY_LLM_BASE_URL=https://multiai.store/v1
PRIMARY_LLM_MODEL=gpt-6.1-sol
PRIMARY_LLM_API_KEY=

# FALLBACK — GOOGLE CLOUD / VERTEX EXPRESS
FALLBACK_LLM_PROVIDER=vertex_gemini
FALLBACK_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_API_KEY=

# FAILOVER
LLM_FALLBACK_ENABLED=true
LLM_MAX_RETRIES=2
LLM_TIMEOUT=180
LLM_MAX_TOKENS=8000
# MultiAI reasoning model: low favors interactive extraction latency
LLM_REASONING_EFFORT=low

# Maximum clarification rounds before explicit draft acceptance
MAX_CLARIFICATION_ROUNDS=3

# Development: exact validation codes in backend logs; production: disable these logs
APP_ENV=development
# Local raw business-text diagnostics; ignored on production, never committed.
LLM_DEBUG_RAW_RESPONSE=false
# Optional single parse truncation retry; remains disabled pending provider benchmarks.
LLM_OUTPUT_RETRY_ENABLED=false
LLM_PARSE_RETRY_MAX_TOKENS=16000

# Graph validation: one focused repair before fallback (independent of JSON retries).
LLM_GRAPH_MAX_RETRIES=1

# Profiled transport/context, validated per-tab cache and bounded request budget.
LLM_PERFORMANCE_ENABLED=true
LLM_REQUEST_BUDGET=450
LLM_FALLBACK_RESERVE=60
PERFORMANCE_CACHE_ENTRIES=64
PERFORMANCE_CACHE_TTL=300
# Real-provider experiments did not preserve quality consistently. Keep disabled.
LLM_COMBINED_ENABLED=false
LLM_PATCH_ENABLED=false

# Bounded corrective and tagged combined parse remain opt-in experiments.
LLM_PATCH_CORRECTIVE_ENABLED=false
LLM_REPAIR_MAX_TOKENS=1600
LLM_COMBINED_PARSE_ENABLED=false
# Exact single-name Modify commands retain preview, validation and Undo.
DETERMINISTIC_MODIFY_ENABLED=true

# Independent output budgets; complete graphs retain their full allowance.
LLM_PARSE_MAX_TOKENS=8000
LLM_CLARIFY_MAX_TOKENS=1500
LLM_MODIFY_MAX_TOKENS=8000
LLM_DOCTOR_MAX_TOKENS=3000
LLM_CORRECTIVE_MAX_TOKENS=8000

# Omit output token limit for primary only; provider defaults still apply.
PRIMARY_LLM_OMIT_TOKEN_LIMIT=false

# Production completeness review and public domain for Compose.
LLM_BUSINESS_COVERAGE_ENABLED=true
SITE_ADDRESS=localhost
