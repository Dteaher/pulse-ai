<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_client_pool" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="client_start" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="submit_application" name="Подать заявку">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="client_wait" name="Ожидать сообщение от компании" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_client_wait</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="receive_addition_request" name="Получить запрос дополнений">
      <bpmn:documentation>оператор запрашивает дополнения</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="provide_additions" name="Дополнить данные">
      <bpmn:documentation>запрашивает дополнения, получает их</bpmn:documentation>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_additions" name="Отправить дополнения">
      <bpmn:documentation>получает их</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_contract" name="Получить договор">
      <bpmn:documentation>Клиент подписывает полученный договор</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="sign_contract" name="Подписать договор">
      <bpmn:documentation>Клиент подписывает полученный договор</bpmn:documentation>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_signed_contract" name="Отправить компании подписанный экземпляр">
      <bpmn:documentation>отправляет компании подписанный экземпляр</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="client_end" name="Процесс завершён">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_client_wait" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_client_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="f16" sourceRef="client_start" targetRef="submit_application" name=""/>
    <bpmn:sequenceFlow id="f17" sourceRef="submit_application" targetRef="Merge_client_wait" name=""/>
    <bpmn:sequenceFlow id="f18" sourceRef="client_wait" targetRef="receive_addition_request" name=""/>
    <bpmn:sequenceFlow id="f19" sourceRef="client_wait" targetRef="receive_contract" name=""/>
    <bpmn:sequenceFlow id="f20" sourceRef="receive_addition_request" targetRef="provide_additions" name=""/>
    <bpmn:sequenceFlow id="f21" sourceRef="provide_additions" targetRef="send_additions" name=""/>
    <bpmn:sequenceFlow id="f22" sourceRef="send_additions" targetRef="Merge_client_wait" name=""/>
    <bpmn:sequenceFlow id="f23" sourceRef="receive_contract" targetRef="sign_contract" name=""/>
    <bpmn:sequenceFlow id="f24" sourceRef="sign_contract" targetRef="send_signed_contract" name=""/>
    <bpmn:sequenceFlow id="f25" sourceRef="send_signed_contract" targetRef="client_end" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_client_wait" sourceRef="Merge_client_wait" targetRef="client_wait" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_company_pool" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>company_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_completeness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeness_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_additions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_additions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculate_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resubmit_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>company_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Руководитель">
        <bpmn:flowNodeRef>manager_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="company_start" name="Получена заявка">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_company_start"/>
    </bpmn:startEvent>
    <bpmn:userTask id="check_completeness" name="Проверить комплектность документов">
      <bpmn:documentation>проверяет комплектность документов</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f_check_completeness_gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="completeness_gateway" name="Комплект документов полный?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если комплект неполный... При полном комплекте", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f_check_completeness_gateway</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="request_additions" name="Запросить дополнения">
      <bpmn:documentation>оператор запрашивает дополнения</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_additions" name="Получить дополнения">
      <bpmn:documentation>получает их</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="calculate_cost" name="Рассчитать стоимость">
      <bpmn:documentation>рассчитывает стоимость</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="prepare_contract" name="Оформить договор">
      <bpmn:documentation>оформляет договор</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="manager_check" name="Проверить договор">
      <bpmn:documentation>Руководитель проверяет договор</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approval_gateway" name="Договор согласован?" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "При согласовании... При отказе руководителя", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>оператор отправляет договор клиенту</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="correct_contract" name="Исправить договор">
      <bpmn:documentation>оператор исправляет договор</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="resubmit_contract" name="Повторно направить договор руководителю">
      <bpmn:documentation>повторно направляет руководителю на проверку</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="receive_signed" name="Получить подписанный экземпляр">
      <bpmn:documentation>отправляет компании подписанный экземпляр</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="archive_contract" name="Архивировать подписанный экземпляр">
      <bpmn:documentation>компания архивирует его</bpmn:documentation>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="company_end" name="Обработка завершена">
      <bpmn:documentation>завершает процесс</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="company_start" targetRef="check_completeness" name=""/>
    <bpmn:sequenceFlow id="f2" sourceRef="completeness_gateway" targetRef="request_additions" name="Комплект неполный">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>комплект неполный</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3" sourceRef="completeness_gateway" targetRef="calculate_cost" name="Комплект полный">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>комплект полный</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="request_additions" targetRef="receive_additions" name=""/>
    <bpmn:sequenceFlow id="f5" sourceRef="receive_additions" targetRef="check_completeness" name=""/>
    <bpmn:sequenceFlow id="f6" sourceRef="calculate_cost" targetRef="prepare_contract" name=""/>
    <bpmn:sequenceFlow id="f7" sourceRef="prepare_contract" targetRef="manager_check" name=""/>
    <bpmn:sequenceFlow id="f8" sourceRef="manager_check" targetRef="approval_gateway" name=""/>
    <bpmn:sequenceFlow id="f9" sourceRef="approval_gateway" targetRef="send_contract" name="Согласовано">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>согласовано</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f10" sourceRef="approval_gateway" targetRef="correct_contract" name="Отказано">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>отказано</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f11" sourceRef="correct_contract" targetRef="resubmit_contract" name=""/>
    <bpmn:sequenceFlow id="f12" sourceRef="resubmit_contract" targetRef="manager_check" name=""/>
    <bpmn:sequenceFlow id="f13" sourceRef="send_contract" targetRef="receive_signed" name=""/>
    <bpmn:sequenceFlow id="f14" sourceRef="receive_signed" targetRef="archive_contract" name=""/>
    <bpmn:sequenceFlow id="f15" sourceRef="archive_contract" targetRef="company_end" name=""/>
    <bpmn:sequenceFlow id="f_check_completeness_gateway" sourceRef="check_completeness" targetRef="completeness_gateway" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="contract_processing" name="Обработка заявки и договора">
    <bpmn:documentation>Оператор получает заявку и проверяет комплектность документов. Если комплект неполный, оператор запрашивает дополнения, получает их и повторяет проверку. При полном комплекте оператор последовательно рассчитывает стоимость и оформляет договор. Руководитель проверяет договор. При согласовании оператор отправляет договор клиенту и завершает обработку. При отказе руководителя оператор исправляет договор и повторно направляет руководителю на проверку. Клиент подписывает полученный договор и отправляет компании подписанный экземпляр, после чего компания архивирует его и завершает процесс.</bpmn:documentation>
    <bpmn:documentation>PULSE_ASSUMPTIONS:[{"id": "a1", "text": "Подача заявки клиентом является необходимым действием, подразумеваемым тем, что оператор получает заявку.", "source": "model_inference", "confidence": 0.86}]</bpmn:documentation>
    <bpmn:participant id="client_pool" name="Клиент" processRef="Process_client_pool">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "client_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="company_pool" name="Организация" processRef="Process_company_pool">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "company_pool"}, {"id": "manager", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "company_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf1" sourceRef="submit_application" targetRef="company_start" name="Заявка"/>
    <bpmn:messageFlow id="mf2" sourceRef="request_additions" targetRef="receive_addition_request" name="Запрос дополнений"/>
    <bpmn:messageFlow id="mf3" sourceRef="send_additions" targetRef="receive_additions" name="Дополнения"/>
    <bpmn:messageFlow id="mf4" sourceRef="send_contract" targetRef="receive_contract" name="Договор"/>
    <bpmn:messageFlow id="mf5" sourceRef="send_signed_contract" targetRef="receive_signed" name="Подписанный экземпляр"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="contract_processing">
      <bpmndi:BPMNShape id="Shape_client_pool" bpmnElement="client_pool" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="2610" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_company_pool" bpmnElement="company_pool" isHorizontal="true">
        <dc:Bounds x="60" y="390" width="2610" height="569"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_operator" bpmnElement="operator" isHorizontal="true">
        <dc:Bounds x="90" y="390" width="2580" height="349"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_manager" bpmnElement="manager" isHorizontal="true">
        <dc:Bounds x="90" y="739" width="2580" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_company_start" bpmnElement="company_start">
        <dc:Bounds x="431.0" y="582.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_check_completeness" bpmnElement="check_completeness">
        <dc:Bounds x="570.0" y="561.5" width="140" height="80"/>
      </bpmndi:BPMNShape>
