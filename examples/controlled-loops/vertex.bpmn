<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_client_pool" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="start_event_client" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>flow_client_start_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_client_submit_application" name="Подать заявку на заключение договора">
      <bpmn:documentation>Клиент подаёт заявку на заключение договора.</bpmn:documentation>
      <bpmn:incoming>flow_client_start_to_submit</bpmn:incoming>
      <bpmn:outgoing>flow_client_submit_to_send</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_task_client_send_documents" name="Отправить документы">
      <bpmn:documentation>Клиент подаёт заявку на заключение договора.</bpmn:documentation>
      <bpmn:incoming>flow_client_submit_to_send</bpmn:incoming>
      <bpmn:outgoing>flow_client_send_to_await_response</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="exclusive_gateway_client_await_response_split" name="Получен ответ?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_client_send_to_await_response</bpmn:incoming>
      <bpmn:incoming>flow_client_resend_to_await_response</bpmn:incoming>
      <bpmn:outgoing>flow_client_await_response_to_receive_correction</bpmn:outgoing>
      <bpmn:outgoing>flow_client_await_response_to_receive_contract</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="receive_task_client_receive_for_correction" name="Получить заявку на исправление">
      <bpmn:documentation>Если документы заполнены неправильно, заявку возвращают клиенту на исправление.</bpmn:documentation>
      <bpmn:incoming>flow_client_await_response_to_receive_correction</bpmn:incoming>
      <bpmn:outgoing>flow_client_receive_for_correction_to_correct</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="task_client_correct_documents" name="Исправить документы">
      <bpmn:documentation>После исправления клиент повторно отправляет документы.</bpmn:documentation>
      <bpmn:incoming>flow_client_receive_for_correction_to_correct</bpmn:incoming>
      <bpmn:outgoing>flow_client_correct_to_resend</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_task_client_resend_documents" name="Повторно отправить документы">
      <bpmn:documentation>После исправления клиент повторно отправляет документы.</bpmn:documentation>
      <bpmn:incoming>flow_client_correct_to_resend</bpmn:incoming>
      <bpmn:outgoing>flow_client_resend_to_await_response</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_task_client_receive_contract" name="Получить договор">
      <bpmn:documentation>Клиент получает договор</bpmn:documentation>
      <bpmn:incoming>flow_client_await_response_to_receive_contract</bpmn:incoming>
      <bpmn:outgoing>flow_client_receive_contract_to_end</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="end_event_client" name="Процесс завершен">
      <bpmn:documentation>и процесс завершается.</bpmn:documentation>
      <bpmn:incoming>flow_client_receive_contract_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_client_start_to_submit" sourceRef="start_event_client" targetRef="task_client_submit_application" name=""/>
    <bpmn:sequenceFlow id="flow_client_submit_to_send" sourceRef="task_client_submit_application" targetRef="send_task_client_send_documents" name=""/>
    <bpmn:sequenceFlow id="flow_client_send_to_await_response" sourceRef="send_task_client_send_documents" targetRef="exclusive_gateway_client_await_response_split" name=""/>
    <bpmn:sequenceFlow id="flow_client_await_response_to_receive_correction" sourceRef="exclusive_gateway_client_await_response_split" targetRef="receive_task_client_receive_for_correction" name="На доработку">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Получена заявка на исправление</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_client_receive_for_correction_to_correct" sourceRef="receive_task_client_receive_for_correction" targetRef="task_client_correct_documents" name=""/>
    <bpmn:sequenceFlow id="flow_client_correct_to_resend" sourceRef="task_client_correct_documents" targetRef="send_task_client_resend_documents" name=""/>
    <bpmn:sequenceFlow id="flow_client_resend_to_await_response" sourceRef="send_task_client_resend_documents" targetRef="exclusive_gateway_client_await_response_split" name=""/>
    <bpmn:sequenceFlow id="flow_client_await_response_to_receive_contract" sourceRef="exclusive_gateway_client_await_response_split" targetRef="receive_task_client_receive_contract" name="Получен договор">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Получен договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_client_receive_contract_to_end" sourceRef="receive_task_client_receive_contract" targetRef="end_event_client" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_organization_pool" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>start_event_organization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_task_operator_receive_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_operator_check_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusive_gateway_check_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_task_operator_return_for_correction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_gateway_start_checks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal_department" name="Юридический отдел">
        <bpmn:flowNodeRef>task_legal_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security_service" name="Служба безопасности">
        <bpmn:flowNodeRef>task_security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Менеджер">
        <bpmn:flowNodeRef>parallel_gateway_end_checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_manager_determine_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusive_gateway_cost_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_manager_revise_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusive_gateway_join_final_step</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_task_manager_send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_event_org</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="head" name="Руководитель">
        <bpmn:flowNodeRef>task_head_approve_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusive_gateway_head_decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event_organization" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>flow_org_start_to_receive_documents</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="receive_task_operator_receive_documents" name="Получить документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_org_start_to_receive_documents</bpmn:incoming>
      <bpmn:incoming>flow_operator_return_for_correction_to_receive_documents</bpmn:incoming>
      <bpmn:outgoing>flow_operator_receive_to_check</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="task_operator_check_documents" name="Проверить документы">
      <bpmn:documentation>Оператор проверяет документы.</bpmn:documentation>
      <bpmn:incoming>flow_operator_receive_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_operator_check_to_gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="exclusive_gateway_check_result" name="Документы корректны?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_operator_check_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_operator_check_result_incorrect</bpmn:outgoing>
      <bpmn:outgoing>flow_operator_check_result_correct</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="send_task_operator_return_for_correction" name="Вернуть заявку на исправление">
      <bpmn:documentation>Если документы заполнены неправильно, заявку возвращают клиенту на исправление.</bpmn:documentation>
      <bpmn:incoming>flow_operator_check_result_incorrect</bpmn:incoming>
      <bpmn:outgoing>flow_operator_return_for_correction_to_receive_documents</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="parallel_gateway_start_checks" name="Начать проверки" gatewayDirection="Diverging">
      <bpmn:documentation>Если всё корректно, юридический отдел и служба безопасности одновременно выполняют проверки.</bpmn:documentation>
      <bpmn:incoming>flow_operator_check_result_correct</bpmn:incoming>
      <bpmn:outgoing>flow_operator_start_checks_to_legal</bpmn:outgoing>
      <bpmn:outgoing>flow_operator_start_checks_to_security</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="task_legal_check" name="Выполнить проверку Юридическим отделом">
      <bpmn:documentation>юридический отдел ... выполняют проверки.</bpmn:documentation>
      <bpmn:incoming>flow_operator_start_checks_to_legal</bpmn:incoming>
      <bpmn:outgoing>flow_legal_check_to_end_checks</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_security_check" name="Выполнить проверку Службой безопасности">
      <bpmn:documentation>служба безопасности ... выполняют проверки.</bpmn:documentation>
      <bpmn:incoming>flow_operator_start_checks_to_security</bpmn:incoming>
      <bpmn:outgoing>flow_security_check_to_end_checks</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="parallel_gateway_end_checks" name="Завершение проверок" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок менеджер определяет стоимость договора.</bpmn:documentation>
      <bpmn:incoming>flow_legal_check_to_end_checks</bpmn:incoming>
      <bpmn:incoming>flow_security_check_to_end_checks</bpmn:incoming>
      <bpmn:outgoing>flow_end_checks_to_determine_cost</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="task_manager_determine_cost" name="Определить стоимость договора">
      <bpmn:documentation>менеджер определяет стоимость договора.</bpmn:documentation>
      <bpmn:incoming>flow_end_checks_to_determine_cost</bpmn:incoming>
      <bpmn:outgoing>flow_manager_determine_cost_to_gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="exclusive_gateway_cost_check" name="Стоимость договора" gatewayDirection="Diverging" default="flow_cost_check_low_cost">
      <bpmn:documentation>Если стоимость больше 500 000 рублей, договор должен согласовать руководитель.</bpmn:documentation>
      <bpmn:incoming>flow_manager_determine_cost_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_cost_check_high_cost</bpmn:outgoing>
      <bpmn:outgoing>flow_cost_check_low_cost</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_head_approve_contract" name="Согласовать договор">
      <bpmn:documentation>договор должен согласовать руководитель.</bpmn:documentation>
      <bpmn:incoming>flow_cost_check_high_cost</bpmn:incoming>
      <bpmn:incoming>flow_manager_revise_to_approve</bpmn:incoming>
      <bpmn:outgoing>flow_head_approve_to_decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="exclusive_gateway_head_decision" name="Решение руководителя" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_head_approve_to_decision</bpmn:incoming>
      <bpmn:outgoing>flow_head_decision_rejected</bpmn:outgoing>
      <bpmn:outgoing>flow_head_decision_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_manager_revise_contract" name="Доработать договор">
      <bpmn:documentation>Если руководитель отклоняет договор, менеджер дорабатывает его и повторно отправляет на согласование.</bpmn:documentation>
      <bpmn:incoming>flow_head_decision_rejected</bpmn:incoming>
      <bpmn:outgoing>flow_manager_revise_to_approve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="exclusive_gateway_join_final_step" name="Договор готов к отправке?" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_cost_check_low_cost</bpmn:incoming>
      <bpmn:incoming>flow_head_decision_approved</bpmn:incoming>
      <bpmn:outgoing>flow_manager_join_to_send_contract</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="send_task_manager_send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>менеджер отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>flow_manager_join_to_send_contract</bpmn:incoming>
      <bpmn:outgoing>flow_manager_send_contract_to_end_org</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_event_org" name="Процесс завершен">
      <bpmn:documentation>и процесс завершается.</bpmn:documentation>
      <bpmn:incoming>flow_manager_send_contract_to_end_org</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_org_start_to_receive_documents" sourceRef="start_event_organization" targetRef="receive_task_operator_receive_documents" name=""/>
    <bpmn:sequenceFlow id="flow_operator_receive_to_check" sourceRef="receive_task_operator_receive_documents" targetRef="task_operator_check_documents" name=""/>
    <bpmn:sequenceFlow id="flow_operator_check_to_gateway" sourceRef="task_operator_check_documents" targetRef="exclusive_gateway_check_result" name=""/>
    <bpmn:sequenceFlow id="flow_operator_check_result_incorrect" sourceRef="exclusive_gateway_check_result" targetRef="send_task_operator_return_for_correction" name="Заполнены неправильно">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Документы заполнены неправильно</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_operator_return_for_correction_to_receive_documents" sourceRef="send_task_operator_return_for_correction" targetRef="receive_task_operator_receive_documents" name=""/>
    <bpmn:sequenceFlow id="flow_operator_check_result_correct" sourceRef="exclusive_gateway_check_result" targetRef="parallel_gateway_start_checks" name="Всё корректно">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Всё корректно</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_operator_start_checks_to_legal" sourceRef="parallel_gateway_start_checks" targetRef="task_legal_check" name=""/>
    <bpmn:sequenceFlow id="flow_operator_start_checks_to_security" sourceRef="parallel_gateway_start_checks" targetRef="task_security_check" name=""/>
    <bpmn:sequenceFlow id="flow_legal_check_to_end_checks" sourceRef="task_legal_check" targetRef="parallel_gateway_end_checks" name=""/>
    <bpmn:sequenceFlow id="flow_security_check_to_end_checks" sourceRef="task_security_check" targetRef="parallel_gateway_end_checks" name=""/>
    <bpmn:sequenceFlow id="flow_end_checks_to_determine_cost" sourceRef="parallel_gateway_end_checks" targetRef="task_manager_determine_cost" name=""/>
    <bpmn:sequenceFlow id="flow_manager_determine_cost_to_gateway" sourceRef="task_manager_determine_cost" targetRef="exclusive_gateway_cost_check" name=""/>
    <bpmn:sequenceFlow id="flow_cost_check_high_cost" sourceRef="exclusive_gateway_cost_check" targetRef="task_head_approve_contract" name="Стоимость &gt; 500 000 руб.">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Стоимость больше 500 000 рублей</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_head_approve_to_decision" sourceRef="task_head_approve_contract" targetRef="exclusive_gateway_head_decision" name=""/>
    <bpmn:sequenceFlow id="flow_head_decision_rejected" sourceRef="exclusive_gateway_head_decision" targetRef="task_manager_revise_contract" name="Отклонено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Руководитель отклоняет договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_manager_revise_to_approve" sourceRef="task_manager_revise_contract" targetRef="task_head_approve_contract" name=""/>
    <bpmn:sequenceFlow id="flow_cost_check_low_cost" sourceRef="exclusive_gateway_cost_check" targetRef="exclusive_gateway_join_final_step" name="Стоимость &lt;= 500 000 руб."/>
    <bpmn:sequenceFlow id="flow_head_decision_approved" sourceRef="exclusive_gateway_head_decision" targetRef="exclusive_gateway_join_final_step" name="Согласовано">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Руководитель согласовал договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_manager_join_to_send_contract" sourceRef="exclusive_gateway_join_final_step" targetRef="send_task_manager_send_contract" name=""/>
    <bpmn:sequenceFlow id="flow_manager_send_contract_to_end_org" sourceRef="send_task_manager_send_contract" targetRef="end_event_org" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="contract_application_process" name="Процесс заключения договора">
    <bpmn:documentation>Клиент подаёт заявку на заключение договора. Оператор проверяет документы. Если документы заполнены неправильно, заявку возвращают клиенту на исправление. После исправления клиент повторно отправляет документы. Если всё корректно, юридический отдел и служба безопасности одновременно выполняют проверки. После завершения обеих проверок менеджер определяет стоимость договора. Если стоимость больше 500 000 рублей, договор должен согласовать руководитель. Если руководитель отклоняет договор, менеджер дорабатывает его и повторно отправляет на согласование. Если стоимость не превышает 500 000 рублей или руководитель согласовал договор, менеджер отправляет договор клиенту. Клиент получает договор, и процесс завершается.</bpmn:documentation>
    <bpmn:participant id="client_pool" name="Клиент" processRef="Process_client_pool">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "client_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="organization_pool" name="Организация" processRef="Process_organization_pool">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "legal_department", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "security_service", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "head", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "organization_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="msg_flow_client_send_app_to_operator_receive" sourceRef="send_task_client_send_documents" targetRef="receive_task_operator_receive_documents" name="Документы заявки"/>
    <bpmn:messageFlow id="msg_flow_operator_return_to_client_receive_for_correction" sourceRef="send_task_operator_return_for_correction" targetRef="receive_task_client_receive_for_correction" name="Заявка на исправление"/>
    <bpmn:messageFlow id="msg_flow_client_resend_to_operator_receive" sourceRef="send_task_client_resend_documents" targetRef="receive_task_operator_receive_documents" name="Исправленные документы"/>
    <bpmn:messageFlow id="msg_flow_manager_send_contract_to_client_receive" sourceRef="send_task_manager_send_contract" targetRef="receive_task_client_receive_contract" name="Договор"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="contract_application_process">
      <bpmndi:BPMNShape id="Shape_client_pool" bpmnElement="client_pool" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="4510" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_organization_pool" bpmnElement="organization_pool" isHorizontal="true">
        <dc:Bounds x="60" y="295" width="4510" height="1015"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_operator" bpmnElement="operator" isHorizontal="true">
        <dc:Bounds x="90" y="295" width="4480" height="275"/>
