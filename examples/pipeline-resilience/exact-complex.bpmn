<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_pool_client" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>cf01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_apply" name="Подать заявку">
      <bpmn:documentation>Клиент подаёт заявку на подключение объекта.</bpmn:documentation>
      <bpmn:incoming>cf01</bpmn:incoming>
      <bpmn:outgoing>cf02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_wait_app" name="Ожидать ответа по заявке" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_c_wait_app</bpmn:incoming>
      <bpmn:outgoing>cf03</bpmn:outgoing>
      <bpmn:outgoing>cf04</bpmn:outgoing>
      <bpmn:outgoing>cf05</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="c_get_correction" name="Получить запрос на доработку">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>cf03</bpmn:incoming>
      <bpmn:outgoing>cf06</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_fix_docs" name="Исправить документы">
      <bpmn:documentation>Клиент исправляет документы</bpmn:documentation>
      <bpmn:incoming>cf06</bpmn:incoming>
      <bpmn:outgoing>cf07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_resend_docs" name="Повторно отправить документы">
      <bpmn:documentation>Клиент исправляет документы и повторно отправляет их оператору.</bpmn:documentation>
      <bpmn:incoming>cf07</bpmn:incoming>
      <bpmn:outgoing>cf08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_get_refusal" name="Получить уведомление об отказе">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>cf04</bpmn:incoming>
      <bpmn:outgoing>cf09</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="c_end_refusal" name="Завершить после отказа">
      <bpmn:documentation>после чего процесс завершается</bpmn:documentation>
      <bpmn:incoming>cf09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="c_get_contract" name="Получить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>cf05</bpmn:incoming>
      <bpmn:outgoing>cf10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_check_contract" name="Проверить договор">
      <bpmn:documentation>Клиент проверяет договор.</bpmn:documentation>
      <bpmn:incoming>cf10</bpmn:incoming>
      <bpmn:incoming>cf15</bpmn:incoming>
      <bpmn:outgoing>cf11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="c_contract_decision" name="Определить согласие с договором" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>cf11</bpmn:incoming>
      <bpmn:outgoing>cf12</bpmn:outgoing>
      <bpmn:outgoing>cf13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="c_return_contract" name="Вернуть договор на доработку">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>cf12</bpmn:incoming>
      <bpmn:outgoing>cf14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_wait_updated" name="Получить изменённый договор">
      <bpmn:documentation>Менеджер изменяет договор и повторно отправляет клиенту.</bpmn:documentation>
      <bpmn:incoming>cf14</bpmn:incoming>
      <bpmn:outgoing>cf15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_sign_contract" name="Подписать договор">
      <bpmn:documentation>он подписывает договор</bpmn:documentation>
      <bpmn:incoming>cf13</bpmn:incoming>
      <bpmn:outgoing>cf16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_send_signed" name="Отправить подписанный договор">
      <bpmn:documentation>и отправляет менеджеру.</bpmn:documentation>
      <bpmn:incoming>cf16</bpmn:incoming>
      <bpmn:outgoing>cf17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="c_end_approved" name="Завершить процесс">
      <bpmn:documentation>после чего процесс завершается</bpmn:documentation>
      <bpmn:incoming>cf17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_c_wait_app" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>cf02</bpmn:incoming>
      <bpmn:incoming>cf08</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_c_wait_app</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="cf01" sourceRef="c_start" targetRef="c_apply" name=""/>
    <bpmn:sequenceFlow id="cf02" sourceRef="c_apply" targetRef="Merge_c_wait_app" name=""/>
    <bpmn:sequenceFlow id="cf03" sourceRef="c_wait_app" targetRef="c_get_correction" name=""/>
    <bpmn:sequenceFlow id="cf04" sourceRef="c_wait_app" targetRef="c_get_refusal" name=""/>
    <bpmn:sequenceFlow id="cf05" sourceRef="c_wait_app" targetRef="c_get_contract" name=""/>
    <bpmn:sequenceFlow id="cf06" sourceRef="c_get_correction" targetRef="c_fix_docs" name=""/>
    <bpmn:sequenceFlow id="cf07" sourceRef="c_fix_docs" targetRef="c_resend_docs" name=""/>
    <bpmn:sequenceFlow id="cf08" sourceRef="c_resend_docs" targetRef="Merge_c_wait_app" name=""/>
    <bpmn:sequenceFlow id="cf09" sourceRef="c_get_refusal" targetRef="c_end_refusal" name=""/>
    <bpmn:sequenceFlow id="cf10" sourceRef="c_get_contract" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="cf11" sourceRef="c_check_contract" targetRef="c_contract_decision" name=""/>
    <bpmn:sequenceFlow id="cf12" sourceRef="c_contract_decision" targetRef="c_return_contract" name="Договор требует доработки">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент не согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cf13" sourceRef="c_contract_decision" targetRef="c_sign_contract" name="Договор согласован">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Клиент согласен</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cf14" sourceRef="c_return_contract" targetRef="c_wait_updated" name=""/>
    <bpmn:sequenceFlow id="cf15" sourceRef="c_wait_updated" targetRef="c_check_contract" name=""/>
    <bpmn:sequenceFlow id="cf16" sourceRef="c_sign_contract" targetRef="c_send_signed" name=""/>
    <bpmn:sequenceFlow id="cf17" sourceRef="c_send_signed" targetRef="c_end_approved" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_c_wait_app" sourceRef="Merge_c_wait_app" targetRef="c_wait_app" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_pool_org" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="p_operator" name="Оператор">
        <bpmn:flowNodeRef>o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_return_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait_corrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_split_checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_join_checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_refusal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p_legal" name="Юридический отдел">
        <bpmn:flowNodeRef>o_legal_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p_security" name="Служба безопасности">
        <bpmn:flowNodeRef>o_security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p_manager" name="Менеджер">
        <bpmn:flowNodeRef>o_form_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_wait_contract_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_change_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_resend_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_get_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_register_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_o_wait_contract_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p_leader" name="Руководитель">
        <bpmn:flowNodeRef>o_decide</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="o_start" name="Получена заявка">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:outgoing>o01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_o_start"/>
    </bpmn:startEvent>
    <bpmn:receiveTask id="o_get_application" name="Получить заявку">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:incoming>o01</bpmn:incoming>
      <bpmn:outgoing>o02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_check_docs" name="Проверить документы">
      <bpmn:documentation>Оператор получает заявку и проверяет документы.</bpmn:documentation>
      <bpmn:incoming>o02</bpmn:incoming>
      <bpmn:incoming>o06</bpmn:incoming>
      <bpmn:outgoing>o03</bpmn:outgoing>
      <bpmn:outgoing>o04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_return_application" name="Вернуть заявку на доработку">
      <bpmn:documentation>оператор возвращает заявку клиенту на доработку.</bpmn:documentation>
      <bpmn:incoming>o03</bpmn:incoming>
      <bpmn:outgoing>o05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_wait_corrected" name="Ожидать исправленные документы">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>o05</bpmn:incoming>
      <bpmn:outgoing>o06</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="o_split_checks" name="Разделить проверки" gatewayDirection="Diverging">
      <bpmn:documentation>юридический отдел и служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>o04</bpmn:incoming>
      <bpmn:outgoing>o07</bpmn:outgoing>
      <bpmn:outgoing>o08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_legal_check" name="Проверить заявку">
      <bpmn:documentation>юридический отдел ... проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>o07</bpmn:incoming>
      <bpmn:outgoing>o09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="o_security_check" name="Проверить заявку">
      <bpmn:documentation>служба безопасности одновременно проверяют заявку.</bpmn:documentation>
      <bpmn:incoming>o08</bpmn:incoming>
      <bpmn:outgoing>o10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="o_join_checks" name="Объединить результаты проверок" gatewayDirection="Converging">
      <bpmn:documentation>После завершения обеих проверок</bpmn:documentation>
      <bpmn:incoming>o09</bpmn:incoming>
      <bpmn:incoming>o10</bpmn:incoming>
      <bpmn:outgoing>o11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="o_decide" name="Принять решение по заявке">
      <bpmn:documentation>руководитель принимает решение.</bpmn:documentation>
      <bpmn:incoming>o11</bpmn:incoming>
      <bpmn:outgoing>o12</bpmn:outgoing>
      <bpmn:outgoing>o13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_send_refusal" name="Отправить уведомление об отказе">
      <bpmn:documentation>оператор отправляет клиенту уведомление об отказе</bpmn:documentation>
      <bpmn:incoming>o12</bpmn:incoming>
      <bpmn:outgoing>o14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="o_end_refusal" name="Завершить после отказа">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>o14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="o_form_contract" name="Сформировать договор">
      <bpmn:documentation>менеджер формирует договор</bpmn:documentation>
      <bpmn:incoming>o13</bpmn:incoming>
      <bpmn:outgoing>o15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>отправляет его клиенту.</bpmn:documentation>
      <bpmn:incoming>o15</bpmn:incoming>
      <bpmn:outgoing>o16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="o_wait_contract_result" name="Ожидать результата проверки договора" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "event"}</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_o_wait_contract_result</bpmn:incoming>
      <bpmn:outgoing>o17</bpmn:outgoing>
      <bpmn:outgoing>o18</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="o_get_returned" name="Получить возвращённый договор">
      <bpmn:documentation>он возвращает договор менеджеру на доработку.</bpmn:documentation>
      <bpmn:incoming>o17</bpmn:incoming>
      <bpmn:outgoing>o19</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_change_contract" name="Изменить договор">
      <bpmn:documentation>Менеджер изменяет договор</bpmn:documentation>
      <bpmn:incoming>o19</bpmn:incoming>
      <bpmn:outgoing>o20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="o_resend_contract" name="Повторно отправить договор клиенту">
      <bpmn:documentation>повторно отправляет клиенту.</bpmn:documentation>
      <bpmn:incoming>o20</bpmn:incoming>
      <bpmn:outgoing>o21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="o_get_signed" name="Получить подписанный договор">
      <bpmn:documentation>и отправляет менеджеру.</bpmn:documentation>
      <bpmn:incoming>o18</bpmn:incoming>
      <bpmn:outgoing>o22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="o_register_contract" name="Зарегистрировать договор">
      <bpmn:documentation>Менеджер регистрирует договор</bpmn:documentation>
      <bpmn:incoming>o22</bpmn:incoming>
      <bpmn:outgoing>o23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="o_end_approved" name="Завершить процесс">
      <bpmn:documentation>после чего процесс завершается.</bpmn:documentation>
      <bpmn:incoming>o23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_o_wait_contract_result" name="Объединить пути" gatewayDirection="Converging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>o16</bpmn:incoming>
      <bpmn:incoming>o21</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_o_wait_contract_result</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="o01" sourceRef="o_start" targetRef="o_get_application" name=""/>
    <bpmn:sequenceFlow id="o02" sourceRef="o_get_application" targetRef="o_check_docs" name=""/>
    <bpmn:sequenceFlow id="o03" sourceRef="o_check_docs" targetRef="o_return_application" name="Документы требуют доработки">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документов не хватает или они заполнены неправильно</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o04" sourceRef="o_check_docs" targetRef="o_split_checks" name="Документы корректны">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Документы корректны</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o05" sourceRef="o_return_application" targetRef="o_wait_corrected" name=""/>
    <bpmn:sequenceFlow id="o06" sourceRef="o_wait_corrected" targetRef="o_check_docs" name=""/>
    <bpmn:sequenceFlow id="o07" sourceRef="o_split_checks" targetRef="o_legal_check" name=""/>
    <bpmn:sequenceFlow id="o08" sourceRef="o_split_checks" targetRef="o_security_check" name=""/>
    <bpmn:sequenceFlow id="o09" sourceRef="o_legal_check" targetRef="o_join_checks" name=""/>
    <bpmn:sequenceFlow id="o10" sourceRef="o_security_check" targetRef="o_join_checks" name=""/>
    <bpmn:sequenceFlow id="o11" sourceRef="o_join_checks" targetRef="o_decide" name=""/>
    <bpmn:sequenceFlow id="o12" sourceRef="o_decide" targetRef="o_send_refusal" name="Отклонить">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка отклонена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o13" sourceRef="o_decide" targetRef="o_form_contract" name="Одобрить">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Заявка одобрена</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o14" sourceRef="o_send_refusal" targetRef="o_end_refusal" name=""/>
    <bpmn:sequenceFlow id="o15" sourceRef="o_form_contract" targetRef="o_send_contract" name=""/>
    <bpmn:sequenceFlow id="o16" sourceRef="o_send_contract" targetRef="Merge_o_wait_contract_result" name=""/>
    <bpmn:sequenceFlow id="o17" sourceRef="o_wait_contract_result" targetRef="o_get_returned" name=""/>
    <bpmn:sequenceFlow id="o18" sourceRef="o_wait_contract_result" targetRef="o_get_signed" name=""/>
    <bpmn:sequenceFlow id="o19" sourceRef="o_get_returned" targetRef="o_change_contract" name=""/>
    <bpmn:sequenceFlow id="o20" sourceRef="o_change_contract" targetRef="o_resend_contract" name=""/>
    <bpmn:sequenceFlow id="o21" sourceRef="o_resend_contract" targetRef="Merge_o_wait_contract_result" name=""/>
    <bpmn:sequenceFlow id="o22" sourceRef="o_get_signed" targetRef="o_register_contract" name=""/>
    <bpmn:sequenceFlow id="o23" sourceRef="o_register_contract" targetRef="o_end_approved" name=""/>
    <bpmn:sequenceFlow id="Flow_Merge_o_wait_contract_result" sourceRef="Merge_o_wait_contract_result" targetRef="o_wait_contract_result" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="process01" name="Подключение объекта">
    <bpmn:documentation>Клиент подаёт заявку на подключение объекта.
Оператор получает заявку и проверяет документы.
Если документов не хватает или они заполнены неправильно,
оператор возвращает заявку клиенту на доработку.
Клиент исправляет документы и повторно отправляет их оператору.

Если документы корректны,
юридический отдел и служба безопасности одновременно проверяют заявку.
После завершения обеих проверок руководитель принимает решение.

Если заявка отклонена,
оператор отправляет клиенту уведомление об отказе,
после чего процесс завершается.

Если заявка одобрена,
менеджер формирует договор и отправляет его клиенту.

Клиент проверяет договор.
Если клиент не согласен,
он возвращает договор менеджеру на доработку.
Менеджер изменяет договор и повторно отправляет клиенту.

Если клиент согласен,
он подписывает договор и отправляет менеджеру.
Менеджер регистрирует договор,
после чего процесс завершается.</bpmn:documentation>
    <bpmn:participant id="pool_client" name="Клиент" processRef="Process_pool_client">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "p_client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "pool_client"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="pool_org" name="Организация" processRef="Process_pool_org">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "p_operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "p_legal", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "p_security", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "pool_org"}, {"id": "p_manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "pool_org"}, {"id": "p_leader", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "pool_org"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf01" sourceRef="c_apply" targetRef="o_start" name="Заявка"/>
    <bpmn:messageFlow id="mf02" sourceRef="o_return_application" targetRef="c_get_correction" name="Запрос на доработку заявки"/>
    <bpmn:messageFlow id="mf03" sourceRef="c_resend_docs" targetRef="o_wait_corrected" name="Исправленные документы"/>
    <bpmn:messageFlow id="mf04" sourceRef="o_send_refusal" targetRef="c_get_refusal" name="Уведомление об отказе"/>
    <bpmn:messageFlow id="mf05" sourceRef="o_send_contract" targetRef="c_get_contract" name="Договор"/>
    <bpmn:messageFlow id="mf06" sourceRef="c_return_contract" targetRef="o_get_returned" name="Договор на доработку"/>
    <bpmn:messageFlow id="mf07" sourceRef="o_resend_contract" targetRef="c_wait_updated" name="Изменённый договор"/>
    <bpmn:messageFlow id="mf08" sourceRef="c_send_signed" targetRef="o_get_signed" name="Подписанный договор"/>
  </bpmn:collaboration>
