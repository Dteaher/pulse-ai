        <dc:Bounds x="2141.0" y="128.5" width="38" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_0" bpmnElement="Flow_0">
        <di:waypoint x="279.0" y="147.5"/>
        <di:waypoint x="380.0" y="147.5"/>
      </bpmndi:BPMNEdge>
