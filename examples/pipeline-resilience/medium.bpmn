<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_client_pool" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="start_client" name="Получено сообщение: Договор">
      <bpmn:documentation>Клиент подписывает полученный договор</bpmn:documentation>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEvent_start_client"/>
    </bpmn:startEvent>
    <bpmn:userTask id="sign_contract" name="Подписать договор">
      <bpmn:documentation>Клиент подписывает полученный договор</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_signed_copy" name="Отправить компании подписанный экземпляр">
      <bpmn:documentation>отправляет компании подписанный экземпляр</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_client" name="Завершить процесс клиента">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f19" sourceRef="start_client" targetRef="sign_contract" name=""/>
    <bpmn:sequenceFlow id="f21" sourceRef="sign_contract" targetRef="send_signed_copy" name=""/>
    <bpmn:sequenceFlow id="f22" sourceRef="send_signed_copy" targetRef="end_client" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_company_pool" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>start_company</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>get_application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_completeness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completeness_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request_additions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_additions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calculate_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correct_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resend_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish_processing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_signed_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>archive_copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_company</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Руководитель">
        <bpmn:flowNodeRef>review_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_company" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="get_application" name="Получить заявку">
      <bpmn:documentation>Оператор получает заявку</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="check_completeness" name="Проверить комплектность документов">
      <bpmn:documentation>проверяет комплектность документов</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="completeness_gateway" name="Комплектность документов" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "Если комплект неполный", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="request_additions" name="Запросить дополнения">
      <bpmn:documentation>оператор запрашивает дополнения</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="receive_additions" name="Получить дополнения">
      <bpmn:documentation>получает их</bpmn:documentation>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="calculate_cost" name="Рассчитать стоимость">
      <bpmn:documentation>оператор последовательно рассчитывает стоимость</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="prepare_contract" name="Оформить договор">
      <bpmn:documentation>оформляет договор</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="review_contract" name="Проверить договор">
      <bpmn:documentation>Руководитель проверяет договор</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approval_gateway" name="Решение руководителя" gatewayDirection="Diverging">
      <bpmn:documentation>PULSE_NODE:{"source_text": "При согласовании... При отказе руководителя", "decision_basis": "data"}</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="correct_contract" name="Исправить договор">
      <bpmn:documentation>оператор исправляет договор</bpmn:documentation>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="resend_contract" name="Повторно направить договор руководителю">
      <bpmn:documentation>повторно направляет руководителю на проверку</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="send_contract" name="Отправить договор клиенту">
      <bpmn:documentation>оператор отправляет договор клиенту</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="finish_processing" name="Завершить обработку">
      <bpmn:documentation>завершает обработку</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="receive_signed_copy" name="Получить подписанный экземпляр">
      <bpmn:documentation>компания ... получает подписанный экземпляр</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="archive_copy" name="Архивировать подписанный экземпляр">
      <bpmn:documentation>компания архивирует его</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_company" name="Конец процесса компании">
      <bpmn:documentation>завершает процесс</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start_company" targetRef="get_application" name=""/>
    <bpmn:sequenceFlow id="f2" sourceRef="get_application" targetRef="check_completeness" name=""/>
    <bpmn:sequenceFlow id="f3" sourceRef="check_completeness" targetRef="completeness_gateway" name=""/>
    <bpmn:sequenceFlow id="f4" sourceRef="completeness_gateway" targetRef="request_additions" name="Неполный комплект">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Комплект неполный</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f5" sourceRef="completeness_gateway" targetRef="calculate_cost" name="Полный комплект">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Комплект полный</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" sourceRef="request_additions" targetRef="receive_additions" name=""/>
    <bpmn:sequenceFlow id="f7" sourceRef="receive_additions" targetRef="check_completeness" name=""/>
    <bpmn:sequenceFlow id="f8" sourceRef="calculate_cost" targetRef="prepare_contract" name=""/>
    <bpmn:sequenceFlow id="f9" sourceRef="prepare_contract" targetRef="review_contract" name=""/>
    <bpmn:sequenceFlow id="f10" sourceRef="review_contract" targetRef="approval_gateway" name=""/>
    <bpmn:sequenceFlow id="f11" sourceRef="approval_gateway" targetRef="send_contract" name="Согласование">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Договор согласован</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f12" sourceRef="approval_gateway" targetRef="correct_contract" name="Отказ">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">
        <bpmn:documentation>Договор отклонён</bpmn:documentation>
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" sourceRef="correct_contract" targetRef="resend_contract" name=""/>
    <bpmn:sequenceFlow id="f14" sourceRef="resend_contract" targetRef="review_contract" name=""/>
    <bpmn:sequenceFlow id="f15" sourceRef="send_contract" targetRef="finish_processing" name=""/>
    <bpmn:sequenceFlow id="f16" sourceRef="finish_processing" targetRef="receive_signed_copy" name=""/>
    <bpmn:sequenceFlow id="f17" sourceRef="receive_signed_copy" targetRef="archive_copy" name=""/>
    <bpmn:sequenceFlow id="f18" sourceRef="archive_copy" targetRef="end_company" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="contract_process" name="Обработка заявки и договора">
    <bpmn:documentation>Оператор получает заявку и проверяет комплектность документов. Если комплект неполный, оператор запрашивает дополнения, получает их и повторяет проверку. При полном комплекте оператор последовательно рассчитывает стоимость и оформляет договор. Руководитель проверяет договор. При согласовании оператор отправляет договор клиенту и завершает обработку. При отказе руководителя оператор исправляет договор и повторно направляет руководителю на проверку. Клиент подписывает полученный договор и отправляет компании подписанный экземпляр, после чего компания архивирует его и завершает процесс.</bpmn:documentation>
    <bpmn:participant id="client_pool" name="Клиент" processRef="Process_client_pool">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "client_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="company_pool" name="Организация" processRef="Process_company_pool">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "company_pool"}, {"id": "manager", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "company_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="mf1" sourceRef="send_contract" targetRef="start_client" name="Договор"/>
    <bpmn:messageFlow id="mf2" sourceRef="send_signed_copy" targetRef="receive_signed_copy" name="Подписанный экземпляр"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="contract_process">
      <bpmndi:BPMNShape id="Shape_client_pool" bpmnElement="client_pool" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="2610" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_company_pool" bpmnElement="company_pool" isHorizontal="true">
        <dc:Bounds x="60" y="390" width="2610" height="560"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_operator" bpmnElement="operator" isHorizontal="true">
        <dc:Bounds x="90" y="390" width="2580" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_manager" bpmnElement="manager" isHorizontal="true">
        <dc:Bounds x="90" y="730" width="2580" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_start_company" bpmnElement="start_company">
