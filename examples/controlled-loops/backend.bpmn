<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://pulse.local/bpmn" exporter="PULSE" exporterVersion="0.2">
  <bpmn:process id="Process_client_pool" name="Клиент" isExecutable="false">
    <bpmn:startEvent id="start_client" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>flow_start_client_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="submit_application" name="Подать заявку на заключение договора">
      <bpmn:documentation>Клиент подаёт заявку на заключение договора.</bpmn:documentation>
      <bpmn:incoming>flow_start_client_to_submit</bpmn:incoming>
      <bpmn:outgoing>flow_submit_to_wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="wait_for_org_response" name="Ожидать ответ от Организации">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_submit_to_wait</bpmn:incoming>
      <bpmn:incoming>flow_resubmit_to_wait</bpmn:incoming>
      <bpmn:outgoing>flow_wait_to_gw_client</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gw_client_response" name="Получен ответ?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_wait_to_gw_client</bpmn:incoming>
      <bpmn:outgoing>flow_gw_client_correction</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_client_contract</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="receive_for_correction_client" name="Получить заявку на исправление">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_gw_client_correction</bpmn:incoming>
      <bpmn:outgoing>flow_receive_correction_to_correct</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="correct_documents" name="Исправить документы">
      <bpmn:documentation>Исправить документы</bpmn:documentation>
      <bpmn:incoming>flow_receive_correction_to_correct</bpmn:incoming>
      <bpmn:outgoing>flow_correct_to_resubmit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="resubmit_documents" name="Повторно отправить документы">
      <bpmn:documentation>После исправления клиент повторно отправляет документы.</bpmn:documentation>
      <bpmn:incoming>flow_correct_to_resubmit</bpmn:incoming>
      <bpmn:outgoing>flow_resubmit_to_wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_contract_client" name="Получить договор">
      <bpmn:documentation>Клиент получает договор, и процесс завершается.</bpmn:documentation>
      <bpmn:incoming>flow_gw_client_contract</bpmn:incoming>
      <bpmn:outgoing>flow_receive_contract_client_to_end</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="end_client_contract_received" name="Договор получен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_receive_contract_client_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_client_to_submit" sourceRef="start_client" targetRef="submit_application" name=""/>
    <bpmn:sequenceFlow id="flow_submit_to_wait" sourceRef="submit_application" targetRef="wait_for_org_response" name=""/>
    <bpmn:sequenceFlow id="flow_wait_to_gw_client" sourceRef="wait_for_org_response" targetRef="gw_client_response" name=""/>
    <bpmn:sequenceFlow id="flow_gw_client_correction" sourceRef="gw_client_response" targetRef="receive_for_correction_client" name="Заявка на исправление">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Заявка на исправление</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_receive_correction_to_correct" sourceRef="receive_for_correction_client" targetRef="correct_documents" name=""/>
    <bpmn:sequenceFlow id="flow_correct_to_resubmit" sourceRef="correct_documents" targetRef="resubmit_documents" name=""/>
    <bpmn:sequenceFlow id="flow_resubmit_to_wait" sourceRef="resubmit_documents" targetRef="wait_for_org_response" name=""/>
    <bpmn:sequenceFlow id="flow_gw_client_contract" sourceRef="gw_client_response" targetRef="receive_contract_client" name="Договор получен">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Договор получен</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_receive_contract_client_to_end" sourceRef="receive_contract_client" targetRef="end_client_contract_received" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_organization_pool" name="Организация" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="operator" name="Оператор">
        <bpmn:flowNodeRef>start_organization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_application_operator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_documents_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_for_correction_operator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive_resubmitted_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_gw_start_checks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="legal_department" name="Юридический отдел">
        <bpmn:flowNodeRef>perform_legal_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="security_service" name="Служба безопасности">
        <bpmn:flowNodeRef>perform_security_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Менеджер">
        <bpmn:flowNodeRef>parallel_gw_end_checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine_contract_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_cost_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_for_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rework_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_contract_to_client</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_organization_process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="supervisor" name="Руководитель">
        <bpmn:flowNodeRef>approve_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_approval_result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_organization" name="Начало процесса">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:outgoing>flow_start_org_to_receive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="receive_application_operator" name="Получить заявку на заключение договора">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_start_org_to_receive</bpmn:incoming>
      <bpmn:outgoing>flow_receive_app_to_check</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="check_documents" name="Проверить документы">
      <bpmn:documentation>Оператор проверяет документы.</bpmn:documentation>
      <bpmn:incoming>flow_receive_app_to_check</bpmn:incoming>
      <bpmn:incoming>flow_receive_resubmitted_documents_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_documents_status" name="Документы заполнены?" gatewayDirection="Diverging" default="flow_correct_docs_to_parallel_start">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_check_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_incorrect_docs_to_send</bpmn:outgoing>
      <bpmn:outgoing>flow_correct_docs_to_parallel_start</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="send_for_correction_operator" name="Вернуть заявку на исправление">
      <bpmn:documentation>Если документы заполнены неправильно, заявку возвращают клиенту на исправление.</bpmn:documentation>
      <bpmn:incoming>flow_incorrect_docs_to_send</bpmn:incoming>
      <bpmn:outgoing>flow_send_for_correction_operator_to_receive_resubmitted</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="receive_resubmitted_documents" name="Получить повторно отправленные документы">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_send_for_correction_operator_to_receive_resubmitted</bpmn:incoming>
      <bpmn:outgoing>flow_receive_resubmitted_documents_to_check</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="parallel_gw_start_checks" name="Начать одновременные проверки" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_correct_docs_to_parallel_start</bpmn:incoming>
      <bpmn:outgoing>flow_parallel_start_to_legal</bpmn:outgoing>
      <bpmn:outgoing>flow_parallel_start_to_security</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="perform_legal_check" name="Выполнить проверку">
      <bpmn:documentation>юридический отдел ... выполняет проверки.</bpmn:documentation>
      <bpmn:incoming>flow_parallel_start_to_legal</bpmn:incoming>
      <bpmn:outgoing>flow_legal_to_parallel_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="perform_security_check" name="Выполнить проверку">
      <bpmn:documentation>служба безопасности одновременно выполняют проверки.</bpmn:documentation>
      <bpmn:incoming>flow_parallel_start_to_security</bpmn:incoming>
      <bpmn:outgoing>flow_security_to_parallel_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="parallel_gw_end_checks" name="Завершение одновременных проверок" gatewayDirection="Converging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_legal_to_parallel_end</bpmn:incoming>
      <bpmn:incoming>flow_security_to_parallel_end</bpmn:incoming>
      <bpmn:outgoing>flow_parallel_end_to_cost</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="determine_contract_cost" name="Определить стоимость договора">
      <bpmn:documentation>После завершения обеих проверок менеджер определяет стоимость договора.</bpmn:documentation>
      <bpmn:incoming>flow_parallel_end_to_cost</bpmn:incoming>
      <bpmn:outgoing>flow_cost_to_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_cost_check" name="Стоимость &gt; 500 000?" gatewayDirection="Diverging" default="flow_cost_low_to_send_contract">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_cost_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_cost_high_to_send_approval</bpmn:outgoing>
      <bpmn:outgoing>flow_cost_low_to_send_contract</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="send_for_approval" name="Отправить договор на согласование">
      <bpmn:documentation>Если стоимость больше 500 000 рублей, договор должен согласовать руководитель.</bpmn:documentation>
      <bpmn:incoming>flow_cost_high_to_send_approval</bpmn:incoming>
      <bpmn:incoming>flow_rework_to_send_approval</bpmn:incoming>
      <bpmn:outgoing>flow_send_for_approval_to_approve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approve_contract" name="Согласовать договор">
      <bpmn:documentation>Если стоимость больше 500 000 рублей, договор должен согласовать руководитель.</bpmn:documentation>
      <bpmn:incoming>flow_send_for_approval_to_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_to_gw_approval_result</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_approval_result" name="Руководитель согласовал?" gatewayDirection="Diverging">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_approve_to_gw_approval_result</bpmn:incoming>
      <bpmn:outgoing>flow_approval_rejected_to_rework</bpmn:outgoing>
      <bpmn:outgoing>flow_approval_approved_to_send_contract</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="rework_contract" name="Доработать договор">
      <bpmn:documentation>менеджер дорабатывает его и повторно отправляет на согласование.</bpmn:documentation>
      <bpmn:incoming>flow_approval_rejected_to_rework</bpmn:incoming>
      <bpmn:outgoing>flow_rework_to_send_approval</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send_contract_to_client" name="Отправить договор клиенту">
      <bpmn:documentation>Если стоимость не превышает 500 000 рублей или руководитель согласовал договор, менеджер отправляет договор клиенту.</bpmn:documentation>
      <bpmn:incoming>flow_cost_low_to_send_contract</bpmn:incoming>
      <bpmn:incoming>flow_approval_approved_to_send_contract</bpmn:incoming>
      <bpmn:outgoing>flow_send_contract_to_end_process</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_organization_process" name="Процесс завершен">
      <bpmn:documentation></bpmn:documentation>
      <bpmn:incoming>flow_send_contract_to_end_process</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_org_to_receive" sourceRef="start_organization" targetRef="receive_application_operator" name=""/>
    <bpmn:sequenceFlow id="flow_receive_app_to_check" sourceRef="receive_application_operator" targetRef="check_documents" name=""/>
    <bpmn:sequenceFlow id="flow_check_to_gw" sourceRef="check_documents" targetRef="gw_documents_status" name=""/>
    <bpmn:sequenceFlow id="flow_incorrect_docs_to_send" sourceRef="gw_documents_status" targetRef="send_for_correction_operator" name="Документы заполнены неправильно">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Документы заполнены неправильно</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_send_for_correction_operator_to_receive_resubmitted" sourceRef="send_for_correction_operator" targetRef="receive_resubmitted_documents" name=""/>
    <bpmn:sequenceFlow id="flow_receive_resubmitted_documents_to_check" sourceRef="receive_resubmitted_documents" targetRef="check_documents" name=""/>
    <bpmn:sequenceFlow id="flow_correct_docs_to_parallel_start" sourceRef="gw_documents_status" targetRef="parallel_gw_start_checks" name="Все корректно"/>
    <bpmn:sequenceFlow id="flow_parallel_start_to_legal" sourceRef="parallel_gw_start_checks" targetRef="perform_legal_check" name=""/>
    <bpmn:sequenceFlow id="flow_parallel_start_to_security" sourceRef="parallel_gw_start_checks" targetRef="perform_security_check" name=""/>
    <bpmn:sequenceFlow id="flow_legal_to_parallel_end" sourceRef="perform_legal_check" targetRef="parallel_gw_end_checks" name=""/>
    <bpmn:sequenceFlow id="flow_security_to_parallel_end" sourceRef="perform_security_check" targetRef="parallel_gw_end_checks" name=""/>
    <bpmn:sequenceFlow id="flow_parallel_end_to_cost" sourceRef="parallel_gw_end_checks" targetRef="determine_contract_cost" name=""/>
    <bpmn:sequenceFlow id="flow_cost_to_gw" sourceRef="determine_contract_cost" targetRef="gw_cost_check" name=""/>
    <bpmn:sequenceFlow id="flow_cost_high_to_send_approval" sourceRef="gw_cost_check" targetRef="send_for_approval" name="Стоимость &gt; 500 000 рублей">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Стоимость больше 500 000 рублей</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_cost_low_to_send_contract" sourceRef="gw_cost_check" targetRef="send_contract_to_client" name="Стоимость &lt;= 500 000 рублей"/>
    <bpmn:sequenceFlow id="flow_send_for_approval_to_approve" sourceRef="send_for_approval" targetRef="approve_contract" name=""/>
    <bpmn:sequenceFlow id="flow_approve_to_gw_approval_result" sourceRef="approve_contract" targetRef="gw_approval_result" name=""/>
    <bpmn:sequenceFlow id="flow_approval_rejected_to_rework" sourceRef="gw_approval_result" targetRef="rework_contract" name="Отклонено">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Руководитель отклоняет договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approval_approved_to_send_contract" sourceRef="gw_approval_result" targetRef="send_contract_to_client" name="Согласовано">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Руководитель согласовал договор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_rework_to_send_approval" sourceRef="rework_contract" targetRef="send_for_approval" name=""/>
    <bpmn:sequenceFlow id="flow_send_contract_to_end_process" sourceRef="send_contract_to_client" targetRef="end_organization_process" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="dogovor_process" name="Заключение договора">
    <bpmn:documentation>Клиент подаёт заявку на заключение договора. Оператор проверяет документы. Если документы заполнены неправильно, заявку возвращают клиенту на исправление. После исправления клиент повторно отправляет документы. Если всё корректно, юридический отдел и служба безопасности одновременно выполняют проверки. После завершения обеих проверок менеджер определяет стоимость договора. Если стоимость больше 500 000 рублей, договор должен согласовать руководитель. Если руководитель отклоняет договор, менеджер дорабатывает его и повторно отправляет на согласование. Если стоимость не превышает 500 000 рублей или руководитель согласовал договор, менеджер отправляет договор клиенту. Клиент получает договор, и процесс завершается.</bpmn:documentation>
    <bpmn:participant id="client_pool" name="Клиент" processRef="Process_client_pool">
      <bpmn:documentation>PULSE:{"kind": "external", "roles": [{"id": "client", "name": "Клиент", "type": "external", "kind": "external", "pool_id": "client_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="organization_pool" name="Организация" processRef="Process_organization_pool">
      <bpmn:documentation>PULSE:{"kind": "internal", "roles": [{"id": "operator", "name": "Оператор", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "legal_department", "name": "Юридический отдел", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "security_service", "name": "Служба безопасности", "type": "department", "kind": "internal", "pool_id": "organization_pool"}, {"id": "manager", "name": "Менеджер", "type": "role", "kind": "internal", "pool_id": "organization_pool"}, {"id": "supervisor", "name": "Руководитель", "type": "role", "kind": "internal", "pool_id": "organization_pool"}]}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="msg_flow_submit_app" sourceRef="submit_application" targetRef="receive_application_operator" name="Заявка на заключение договора"/>
    <bpmn:messageFlow id="msg_flow_return_for_correction" sourceRef="send_for_correction_operator" targetRef="receive_for_correction_client" name="Заявка на исправление"/>
    <bpmn:messageFlow id="msg_flow_resubmit_docs" sourceRef="resubmit_documents" targetRef="receive_resubmitted_documents" name="Повторно отправленные документы"/>
    <bpmn:messageFlow id="msg_flow_send_contract" sourceRef="send_contract_to_client" targetRef="receive_contract_client" name="Договор"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="dogovor_process">
      <bpmndi:BPMNShape id="Shape_client_pool" bpmnElement="client_pool" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="3370" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_organization_pool" bpmnElement="organization_pool" isHorizontal="true">
        <dc:Bounds x="60" y="295" width="3370" height="1015"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_operator" bpmnElement="operator" isHorizontal="true">
        <dc:Bounds x="90" y="295" width="3340" height="275"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_legal_department" bpmnElement="legal_department" isHorizontal="true">
        <dc:Bounds x="90" y="570" width="3340" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_security_service" bpmnElement="security_service" isHorizontal="true">
        <dc:Bounds x="90" y="725" width="3340" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_manager" bpmnElement="manager" isHorizontal="true">
        <dc:Bounds x="90" y="880" width="3340" height="275"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_supervisor" bpmnElement="supervisor" isHorizontal="true">
        <dc:Bounds x="90" y="1155" width="3340" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_start_client" bpmnElement="start_client">
        <dc:Bounds x="241.0" y="128.5" width="38" height="38"/>
