      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f7" bpmnElement="f7">
        <di:waypoint x="1210.0" y="506.6666666666667"/>
        <di:waypoint x="1210.0" y="416"/>
        <di:waypoint x="640.0" y="416"/>
        <di:waypoint x="640.0" y="552.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f8" bpmnElement="f8">
        <di:waypoint x="1090.0" y="638.3333333333334"/>
        <di:waypoint x="1140.0" y="638.3333333333334"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f9" bpmnElement="f9">
        <di:waypoint x="1280.0" y="638.3333333333334"/>
        <di:waypoint x="1315.0" y="638.3333333333334"/>
        <di:waypoint x="1315.0" y="872.5"/>
        <di:waypoint x="1330.0" y="872.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f10" bpmnElement="f10">
        <di:waypoint x="1470.0" y="872.5"/>
        <di:waypoint x="1564.0" y="872.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f11" bpmnElement="f11">
        <di:waypoint x="1616.0" y="872.5"/>
        <di:waypoint x="1651.0" y="872.5"/>
        <di:waypoint x="1651.0" y="638.3333333333334"/>
        <di:waypoint x="1710.0" y="638.3333333333334"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1624.0" y="832.5" width="130" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f12" bpmnElement="f12">
        <di:waypoint x="1616.0" y="872.5"/>
        <di:waypoint x="1651.0" y="872.5"/>
        <di:waypoint x="1651.0" y="546.6666666666667"/>
